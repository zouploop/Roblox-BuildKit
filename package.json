{
  "name": "roblox-buildkit-mcp",
  "version": "0.1.0",
  "private": true,
  "description": "AI-assisted Roblox scene building toolkit: MCP server, Studio plugin, browser Stage editor, live Mirror sync, parametric placement, and QA.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "roblox-buildkit-mcp": "dist/index.js"
  },
  "scripts": {
    "build": "tsc && node scripts/gen-rbxmx.mjs && node scripts/check-plugin.mjs && node scripts/postbuild.mjs",
    "setup": "node scripts/setup-mcp.mjs",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "puppeteer": "^25.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "typescript": "^7.0.2",
    "vitest": "^4.1.0"
  },
  "overrides": {
    "@hono/node-server": "^2.0.5",
    "hono": "^4.13.0",
    "ip-address": "^10.3.0",
    "fast-uri": "^3.1.5",
    "body-parser": "^2.2.3"
  }
}
