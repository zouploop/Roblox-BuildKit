{
  "name": "roblox-buildkit-mcp",
  "version": "0.1.0",
  "private": true,
  "description": "MCP server that gives Claude a steerable camera, cutaway/floor-plan capture, and parametric build primitives for Roblox Studio (paired with BuildKitPlugin).",
  "type": "module",
  "bin": {
    "roblox-buildkit-mcp": "dist/index.js"
  },
  "scripts": {
    "build": "tsc && node scripts/gen-rbxmx.mjs",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.5.0",
    "vitest": "^2.1.0"
  }
}
