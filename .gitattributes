# BuildKitPlugin.rbxmx is GENERATED by `npm run build` (scripts/gen-rbxmx.mjs) but is
# also tracked, so users can install the plugin without running the toolchain. Git's
# autocrlf would otherwise rewrite its line endings on checkout, making every local
# build produce a whole-file diff against a byte-identical artifact.
*.rbxmx -text

# Keep the plugin source itself stable across platforms for the same reason: the .rbxmx
# embeds it verbatim, so a CRLF checkout would change the generated file too.
*.luau text eol=lf
