		candelabra = function(s)
			local b = s.color or { 130, 108, 60 }
			local wax, fo, fy = { 226, 218, 198 }, { 240, 140, 40 }, { 255, 220, 110 }
			local out = {
				pp("cylinder", 0, 0.17, 0, 0.35, 1.5, 1.5, b, "Metal", VROT),
				pp("cylinder", 0, 0.45, 0, 0.22, 1.05, 1.05, b, "Metal", VROT),
				pp("cylinder", 0, 1.45, 0, 2.6, 0.24, 0.24, b, "Metal", VROT),
				pp("ball", 0, 0.95, 0, 0.46, 0.52, 0.46, b, "Metal"),
				pp("ball", 0, 1.7, 0, 0.36, 0.4, 0.36, b, "Metal"),
				pp("ball", 0, 2.55, 0, 0.3, 0.3, 0.3, b, "Metal"),
			}
			for _, a in ipairs({ 90, 210, 330 }) do
				local r = math.rad(a)
				out[#out + 1] = pp("ball", math.sin(r) * 0.5, 0.18, math.cos(r) * 0.5, 0.34, 0.28, 0.5, b, "Metal")
			end
			-- CONNECTED scroll arms: polyline, each segment spans exact endpoints (+0.08 overlap
			-- to seal joints) so arms are continuous, not floating segments.
			local function arm(sgn)
				local P = { { 0.16 * sgn, 1.95 }, { 0.7 * sgn, 1.78 }, { 1.15 * sgn, 2.2 }, { 1.2 * sgn, 2.9 } }
				for i = 1, #P - 1 do
					local x1, y1, x2, y2 = P[i][1], P[i][2], P[i + 1][1], P[i + 1][2]
					local dx, dy = x2 - x1, y2 - y1
					local len = math.sqrt(dx * dx + dy * dy)
					local w = 0.16 - (i - 1) * 0.015
					out[#out + 1] = pp("cylinder", (x1 + x2) / 2, (y1 + y2) / 2, 0, len + 0.08, w, w, b, "Metal", { rot = { 0, 0, math.deg(math.atan2(dy, dx)) } })
				end
			end
			arm(-1)
			arm(1)
			-- 3 candle stations (center higher): bobeche plate + cup + candle + layered flame
			for _, st in ipairs({ { 0, 2.65, true }, { -1.2, 2.9, false }, { 1.2, 2.9, false } }) do
				local x, by, lit = st[1], st[2], st[3]
				out[#out + 1] = pp("cylinder", x, by, 0, 0.08, 0.85, 0.85, { 134, 112, 64 }, "Metal", VROT)
				out[#out + 1] = pp("cylinder", x, by + 0.18, 0, 0.3, 0.4, 0.4, b, "Metal", VROT)
				out[#out + 1] = pp("cylinder", x, by + 0.75, 0, 1.0, 0.3, 0.3, wax, "SmoothPlastic", VROT)
				out[#out + 1] = pp("ball", x, by + 1.35, 0, 0.26, 0.5, 0.26, fo, "Neon", lit and { light = { color = { 255, 160, 60 }, brightness = 2, range = 15 } } or nil)
				out[#out + 1] = pp("ball", x, by + 1.4, 0, 0.14, 0.32, 0.14, fy, "Neon")
			end
			return out
		end,
		tankard = function(s)
			local glass = { 218, 228, 230 }
			local out = {
				pp("cylinder", 0, 0.12, 0, 0.22, 1.65, 1.65, { 205, 210, 214 }, "SmoothPlastic", { rot = { 0, 0, 90 }, transparency = 0.4 }),
				pp("cylinder", 0, 1.05, 0, 1.85, 1.34, 1.34, s.color or { 205, 150, 38 }, "SmoothPlastic", { rot = { 0, 0, 90 }, transparency = 0.05 }), -- beer
				pp("cylinder", 0, 1.15, 0, 2.0, 1.5, 1.5, glass, "SmoothPlastic", { rot = { 0, 0, 90 }, transparency = 0.5 }), -- glass
				pp("cylinder", 0, 2.0, 0, 0.45, 1.42, 1.42, { 245, 240, 226 }, "SmoothPlastic", VROT), -- foam head
				pp("ball", 0, 2.25, 0, 0.5, 0.34, 0.5, { 249, 245, 232 }, "SmoothPlastic"),
				pp("box", 0.9, 1.75, 0, 0.4, 0.18, 0.2, glass, "SmoothPlastic", { transparency = 0.45 }), -- handle
				pp("box", 1.12, 1.15, 0, 0.18, 1.15, 0.2, glass, "SmoothPlastic", { transparency = 0.45 }),
				pp("box", 0.9, 0.6, 0, 0.4, 0.18, 0.2, glass, "SmoothPlastic", { transparency = 0.45 }),
			}
			for i = 1, 6 do
				local a = math.rad((i / 6) * 360)
				out[#out + 1] = pp("ball", math.sin(a) * 0.5, 2.18, math.cos(a) * 0.5, 0.42, 0.34, 0.42, { 248, 244, 230 }, "SmoothPlastic") -- froth
			end
			return out
		end,
		mace = function(s)
			local steel = s.color or { 150, 152, 158 }
			local out = {
				pp("cylinder", 0, 1.5, 0, 3.0, 0.2, 0.2, { 82, 56, 38 }, "Wood", VROT), -- haft
				pp("ball", 0, 0.1, 0, 0.34, 0.34, 0.34, { 120, 100, 55 }, "Metal"), -- pommel
				pp("ball", 0, 3.35, 0, 1.0, 1.0, 1.0, { 120, 122, 128 }, "Metal"), -- head
				pp("cylinder", 0, 4.3, 0, 0.7, 0.2, 0.2, steel, "Metal", VROT), -- top spike
			}
			for _, gy in ipairs({ 0.6, 1.0, 1.4 }) do
				out[#out + 1] = pp("cylinder", 0, gy, 0, 0.12, 0.22, 0.22, { 48, 38, 28 }, "SmoothPlastic", VROT) -- grip bands
			end
			local function ring(cy, n, r, len, off)
				for i = 1, n do
					local a = (i / n) * 360 + off
					local rr = math.rad(a)
					out[#out + 1] = pp("cylinder", math.sin(rr) * r, cy, math.cos(rr) * r, len, 0.2, 0.2, steel, "Metal", { rot = { 0, a, 0 } }) -- spike
				end
			end
			ring(3.35, 8, 0.6, 0.7, 0)
			ring(3.78, 5, 0.45, 0.55, 30)
			ring(2.92, 5, 0.45, 0.55, 30)
			return out
		end,
	}
end

-- Scale a part spec's pos/size (+ light range) by k for uniform prop resizing.
local function scaleP(ps, k)
	if k == 1 then return ps end
	local s, p = ps.size or { 1, 1, 1 }, ps.pos or { 0, 0, 0 }
	local t = {}
	for key, v in pairs(ps) do t[key] = v end
	t.size = { s[1] * k, s[2] * k, s[3] * k }
	t.pos = { p[1] * k, p[2] * k, p[3] * k }
	if ps.light and ps.light.range then
		t.light = { color = ps.light.color, brightness = ps.light.brightness, range = ps.light.range * k }
	end
	return t
end

-- Opt-in CSG for props: SUBTRACT parts flagged `negate` (real hollow vessels), then
-- UNION the remaining solids into one smooth operation. Guarded — any failure leaves
-- the parts as-is and returns false. Returns true if a union replaced the parts.
local function csgProp(model)
	local solids, negs = {}, {}
	for _, p in ipairs(model:GetChildren()) do
		if p:IsA("BasePart") then
			if p:GetAttribute("__negate") then table.insert(negs, p) else table.insert(solids, p) end
		end
	end
	if #solids == 0 then return false end
	-- tri-budget guard: a CSG union simplifies/errors past Roblox's ~20k-tri cap, so skip CSG
	-- on very part-heavy props (keep them as separate parts) rather than risk a degenerate union.
	if (#solids + #negs) > 48 then return false end
	-- (BasePart:Union/SubtractAsync used here for reliability — they consume inputs and return
	-- the operation directly. GeometryService:UnionAsync is the recommended future path but
	-- returns an array + doesn't consume inputs; migrate once it can be verified post-restart.)
	local primary = table.remove(solids, 1)
	if #negs > 0 then
		local ok, res = pcall(function() return primary:SubtractAsync(negs) end)
		if not ok or typeof(res) ~= "Instance" or not res:IsA("BasePart") then return false end
		res.Parent = model
		primary = res
	end
	if #solids > 0 then
		local ok, res = pcall(function() return primary:UnionAsync(solids) end)
		if not ok or typeof(res) ~= "Instance" or not res:IsA("BasePart") then return false end
		res.Parent = model
		primary = res
	end
	primary.Name = model.Name .. "Union"
	primary.Anchored = true
	pcall(function() primary.UsePartColor = true end) -- keep the source parts' colours
	pcall(function() primary.CollisionFidelity = Enum.CollisionFidelity.Box end) -- cheap collision for small props
	pcall(function() primary.RenderFidelity = Enum.RenderFidelity.Precise end) -- crisp up-close render
		-- BasePart Union/SubtractAsync do NOT consume their inputs: the source parts and the
		-- intermediate subtract-union survive as orphan children. Destroy everything but the
		-- final union so the prop is ONE clean solid (not union + leftover raw parts).
		for _, p in ipairs(model:GetChildren()) do
			if p:IsA("BasePart") and p ~= primary then pcall(function() p:Destroy() end) end
		end
	model.PrimaryPart = primary
	return true
end

-- prop: a multi-part prop from either a named preset (spec.prop) or an explicit
-- `parts` list (relative to spec.center). Lets rbx_build make ANY prop (cigarette,
-- mug, lamp...) without a dedicated kind or execute_luau. Tagged parametric so the
-- Scale attribute (and spec edits) rebuild it in place like the furniture kinds.
-- With spec.csg it's instead unioned into one smooth solid (final bake, not parametric).
local function buildProp(spec)
	local c = spec.center or { 0, 0, 0 }
	local k = tonumber(spec.scale) or 1
	-- Props own their CSG (csgProp below). Clear spec.csg so the later applyQuality pass
	-- doesn't ALSO run the furniture csgShell on the same model (was producing 2-3 unions).
	local wantCsg = spec.csg
	spec.csg = nil
	local parts = spec.parts
	local pname = spec.prop and tostring(spec.prop):lower() or nil
	if pname and PROP_PRESETS[pname] then
		parts = PROP_PRESETS[pname](spec)
	end
	parts = parts or {}
	local default = pname and (pname:sub(1, 1):upper() .. pname:sub(2)) or "Prop"
	local model = getOrMakeModel(spec.parent, spec.name or default)
	for _, ps in ipairs(parts) do
		makePart(model, scaleP(ps, k), c[1], c[2], c[3])
	end
	model.PrimaryPart = model:FindFirstChildWhichIsA("BasePart")
	-- Opt-in CSG: union solids (subtract `negate` parts first) into one smooth solid.
	-- A union isn't a parts list, so CSG props skip the regen script (final bake, not parametric).
	if wantCsg and csgProp(model) then
		return model
	end
	-- Self-contained procedural model: stash the UNSCALED parts + embed a runtime
	-- regen Script so the prop rebuilds itself from Scale/parts without the plugin.
	local okj, jp = pcall(function() return HttpService:JSONEncode(parts) end)
	if okj then model:SetAttribute("BuildKitParts", jp) end
	local rs = Instance.new("Script")
	rs.Name = "BuildKitRegen"
	rs.Source = PROP_REGEN_SOURCE
	rs.Parent = model
	return model
end

-- a wall along an axis with optional openings (doors/windows)
-- axis "X": wall runs along world X, normal is Z (fixed = z)
-- axis "Z": wall runs along world Z, normal is X (fixed = x)
-- openings: { {center=lateralOffset, width=w, sill=fromBase, top=fromBase}, ... }
local function buildWall(parent, axis, fixed, spanCenter, spanLen, baseY, height, thickness, color, mat, openings)
	local left = spanCenter - spanLen / 2
	local right = spanCenter + spanLen / 2
	openings = openings or {}
	table.sort(openings, function(a, b)
		return a.center < b.center
	end)

	local function vSeg(a, b)
		if b - a <= 0.05 then
			return
		end
		local c = (a + b) / 2
		local len = b - a
		if axis == "X" then
			makeBox(parent, c, baseY + height / 2, fixed, len, height, thickness, color, mat, "Wall")
		else
			makeBox(parent, fixed, baseY + height / 2, c, thickness, height, len, color, mat, "Wall")
		end
	end
	local function fill(aL, aR, yb, yt)
		if (aR - aL) <= 0.05 or (yt - yb) <= 0.05 then
			return
		end
		local c = (aL + aR) / 2
		local len = aR - aL
		local cy = (yb + yt) / 2
		local hh = yt - yb
		if axis == "X" then
			makeBox(parent, c, cy, fixed, len, hh, thickness, color, mat, "Wall")
		else
			makeBox(parent, fixed, cy, c, thickness, hh, len, color, mat, "Wall")
		end
	end

	local cursor = left
	for _, o in ipairs(openings) do
		local oL = spanCenter + o.center - o.width / 2
		local oR = spanCenter + o.center + o.width / 2
		vSeg(cursor, oL)
		if o.sill and o.sill > 0 then
			fill(oL, oR, baseY, baseY + o.sill)
		end
		local top = o.top or height
		if top < height then
			fill(oL, oR, baseY + top, baseY + height)
		end
		cursor = oR
	end
	vSeg(cursor, right)
end

local function buildRoom(spec)
	local c = Vector3.new(spec.center[1], spec.center[2], spec.center[3])
	local w, h, d = spec.size[1], spec.size[2], spec.size[3]
	local t = spec.thickness or 1
	local color = colorOf(spec.color, Color3.fromRGB(150, 140, 128))
	local mat = matOf(spec.material, Enum.Material.Concrete)
	local model = getOrMakeModel(spec.parent, spec.name or "Room")
	local baseY = c.Y - h / 2

	if spec.floor ~= false then
		makeBox(model, c.X, baseY - t / 2, c.Z, w, t, d, color, Enum.Material.WoodPlanks, "Floor")
	end
	if spec.ceiling ~= false then
		makeBox(model, c.X, baseY + h + t / 2, c.Z, w, t, d, color, mat, "Ceiling")
	end

	local function openingsFor(wall)
		local list = {}
		if spec.door and spec.door.wall == wall then
			table.insert(list, { center = 0, width = spec.door.width, sill = 0, top = spec.door.height })
		end
		if spec.windows then
			for _, wd in ipairs(spec.windows) do
				if wd.wall == wall then
					table.insert(
						list,
						{ center = wd.offset or 0, width = wd.width, sill = wd.sill, top = wd.sill + wd.height }
					)
				end
			end
		end
		return list
	end

	buildWall(model, "X", c.Z + d / 2 + t / 2, c.X, w + 2 * t, baseY, h, t, color, mat, openingsFor("front"))
	buildWall(model, "X", c.Z - d / 2 - t / 2, c.X, w + 2 * t, baseY, h, t, color, mat, openingsFor("back"))
	buildWall(model, "Z", c.X - w / 2 - t / 2, c.Z, d, baseY, h, t, color, mat, openingsFor("left"))
	buildWall(model, "Z", c.X + w / 2 + t / 2, c.Z, d, baseY, h, t, color, mat, openingsFor("right"))
	return model
end

local function buildStairs(spec)
	local c = Vector3.new(spec.center[1], spec.center[2], spec.center[3])
	local w, h, d = spec.size[1], spec.size[2], spec.size[3]
	local color = colorOf(spec.color, Color3.fromRGB(140, 134, 122))
	local mat = matOf(spec.material, Enum.Material.Concrete)
	local model = getOrMakeModel(spec.parent, spec.name or "Stairs")
	local steps = spec.steps or math.max(2, math.floor(h / 0.6))
	local rise = h / steps
	local run = d / steps
	for i = 0, steps - 1 do
		local sy = (c.Y - h / 2) + rise * (i + 0.5)
		local sz = (c.Z - d / 2) + run * (i + 0.5)
		makeBox(model, c.X, sy, sz, w, rise, run, color, mat, "Step")
	end
	return model
end

local function buildSlab(spec)
	local c = Vector3.new(spec.center[1], spec.center[2], spec.center[3])
	local w, h, d = spec.size[1], spec.size[2], spec.size[3]
	local color = colorOf(spec.color, Color3.fromRGB(150, 140, 128))
	local mat = matOf(spec.material, Enum.Material.Concrete)
	local model = getOrMakeModel(spec.parent, spec.name or "Slab")
	makeBox(model, c.X, c.Y, c.Z, w, h, d, color, mat, "Slab")
	return model
end

-- ---------- cabinet: clean parametric furniture ------------------------------
-- Encodes the joinery lessons so the geometry is z-fight-/gap-free by construction:
-- sides are the outer frame; top/bottom/back fit BETWEEN them (butt, never coplanar-
-- overlapping); drawer trays MEET their fronts (one joined assembly); doors fill the
-- opening with a tight reveal, hinge on the OUTER edge, and swing OUTWARD (+Z front).
-- rbx_qa stays the verifier. Animated out of the box via an embedded controller.
local CABINET_CONTROLLER = [==[
local TweenService = game:GetService("TweenService")
local model = script.Parent
for _, m in ipairs(model:GetDescendants()) do
	if m:IsA("Model") then
		local kind = m:GetAttribute("Kind")
		if (kind == "drawer" or kind == "door") and m.PrimaryPart then
			local prompt = m.PrimaryPart:FindFirstChildWhichIsA("ProximityPrompt")
			if prompt then
				local closed = m:GetPivot()
				local opened
				if kind == "drawer" then
					opened = closed * CFrame.new(0, 0, m:GetAttribute("Travel") or 3)
				else
					-- hinge stored as a LOCAL offset so it travels with the cabinet when moved/rotated
					local hl = m:GetAttribute("HingeLocal")
					local pc
					if hl then
						pc = closed * CFrame.new(hl)
					else
						pc = CFrame.new(m:GetAttribute("HingeX"), closed.Position.Y, m:GetAttribute("HingeZ"))
					end
					opened = pc * CFrame.Angles(0, math.rad(m:GetAttribute("Swing") or 100), 0) * pc:Inverse() * closed
				end
				local isOpen = false
				local nv = Instance.new("NumberValue"); nv.Parent = m
				nv.Changed:Connect(function(a) m:PivotTo(closed:Lerp(opened, a)) end)
				prompt.Triggered:Connect(function()
					isOpen = not isOpen
					prompt.ActionText = isOpen and "Close" or "Open"
					TweenService:Create(nv, TweenInfo.new(0.45, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { Value = isOpen and 1 or 0 }):Play()
				end)
			end
		end
	end
end
]==]

local function cabinetDrawer(parent, cx, cy, w, h, frontZ, depth, col, hw, inner)
	local dm = Instance.new("Model"); dm.Name = "Drawer"; dm:SetAttribute("Kind", "drawer")
	local t = 0.3
	local front = makeBox(dm, cx, cy, frontZ - t / 2, w, h, t, col, Enum.Material.WoodPlanks, "Front")
	dm.PrimaryPart = front
	dm:SetAttribute("Travel", math.min(depth - 1.2, 3.4))
	barPull(dm, cx, cy + 0.02, frontZ, w, hw)
	local bd = math.min(depth - 1.4, 3.8)
	local tf = frontZ - t + 0.05 -- tray front overlaps the front's back -> joined assembly
	local tb = tf - bd
	local bw = w - 0.5
	makeBox(dm, cx, cy - h / 2 + 0.16, (tf + tb) / 2, bw, 0.12, bd, inner, Enum.Material.WoodPlanks, "TrayBottom")
	makeBox(dm, cx - bw / 2, cy, (tf + tb) / 2, 0.12, h - 0.28, bd, inner, Enum.Material.WoodPlanks, "TrayL")
	makeBox(dm, cx + bw / 2, cy, (tf + tb) / 2, 0.12, h - 0.28, bd, inner, Enum.Material.WoodPlanks, "TrayR")
	makeBox(dm, cx, cy, tb + 0.06, bw, h - 0.28, 0.12, inner, Enum.Material.WoodPlanks, "TrayBack")
	local pp = Instance.new("ProximityPrompt"); pp.ActionText = "Open"; pp.ObjectText = "Drawer"
	pp.HoldDuration = 0; pp.MaxActivationDistance = 12; pp.RequiresLineOfSight = false; pp.Parent = front
	dm.Parent = parent
end

local function cabinetDoor(parent, cx, cy, dw, dh, frontZ, hingeX, swing, col, hw, style, panelCol)
	local dm = Instance.new("Model"); dm.Name = "Door"; dm:SetAttribute("Kind", "door")
	dm:SetAttribute("Swing", swing)
	local t = 0.3
	-- hinge = outer-front corner, stored LOCAL to the door (relative to its PrimaryPart pivot at
	-- cx, frontZ-t/2) so opening stays correct after the cabinet is moved/rotated. cx = door centre,
	-- hingeX = outer edge -> local X = hingeX-cx (±dw/2); front face -> local Z = +t/2.
	dm:SetAttribute("HingeLocal", Vector3.new(hingeX - cx, 0, t / 2))
	local front
	if style == "shaker" then
		-- frame (4 rails butting at corners) + a recessed center panel that overlaps the
		-- rails' inner edge (joined) but shares NO coincident face with them (no z-fight,
		-- and no big front slab to deep-overlap). True shaker, qa-clean.
		local rw = math.max(0.4, math.min(0.7, dw * 0.16, dh * 0.1))
		front = makeBox(dm, cx, cy + dh / 2 - rw / 2, frontZ - t / 2, dw, rw, t, col, Enum.Material.WoodPlanks, "RailTop")
		makeBox(dm, cx, cy - dh / 2 + rw / 2, frontZ - t / 2, dw, rw, t, col, Enum.Material.WoodPlanks, "RailBottom")
		makeBox(dm, cx - dw / 2 + rw / 2, cy, frontZ - t / 2, rw, dh - 2 * rw, t, col, Enum.Material.WoodPlanks, "RailLeft")
		makeBox(dm, cx + dw / 2 - rw / 2, cy, frontZ - t / 2, rw, dh - 2 * rw, t, col, Enum.Material.WoodPlanks, "RailRight")
		makeBox(dm, cx, cy, frontZ - t / 2 + 0.02, dw - 2 * rw + 0.1, dh - 2 * rw + 0.1, 0.1, panelCol or col, Enum.Material.WoodPlanks, "Panel")
		dm.PrimaryPart = front
	else
		front = makeBox(dm, cx, cy, frontZ - t / 2, dw, dh, t, col, Enum.Material.WoodPlanks, "Front")
		dm.PrimaryPart = front
	end
	local freeSign = (cx > hingeX) and 1 or -1
	roundKnob(dm, cx + freeSign * (dw / 2 - 0.4), cy, frontZ, hw)
	local pp = Instance.new("ProximityPrompt"); pp.ActionText = "Open"; pp.ObjectText = "Cabinet"
	pp.HoldDuration = 0; pp.MaxActivationDistance = 12; pp.RequiresLineOfSight = false; pp.Parent = front
	dm.Parent = parent
end

-- Drop-in basin (its own joined Model) that sits THROUGH the counter/top hole the
-- cabinet cut for it: walls + bottom hang below, top stays OPEN (no capping rim).
-- ow/od = the hole's width/depth; wallZ = hole's BACK (-Z, wall-side) edge — the
-- faucet rises there and the gooseneck arches FORWARD (+Z) over the basin.
local function buildSink(parent, sCx, topY, cz, ow, od, wallZ, sink, hw)
	local sm = Instance.new("Model"); sm.Name = "Sink"
	local bc = colorOf(sink.basinColor, Color3.fromRGB(230, 231, 234))
	local wt = 0.25
	local rimTop = topY + 0.44 -- = the counter top surface; basin walls rise flush to it
	local down = sink.basinDepth or 2.6
	local botY = rimTop - down
	-- carcass pattern: L/R are the frame; Front(+Z)/Back(-Z)/Bottom fit BETWEEN them
	-- (butt joints — no coplanar outer faces, so no self z-fight). Top left OPEN.
	local iw = ow - 2 * wt
	makeBox(sm, sCx - ow / 2 + wt / 2, rimTop - down / 2, cz, wt, down, od, bc, Enum.Material.SmoothPlastic, "BasinL")
	makeBox(sm, sCx + ow / 2 - wt / 2, rimTop - down / 2, cz, wt, down, od, bc, Enum.Material.SmoothPlastic, "BasinR")
	makeBox(sm, sCx, rimTop - down / 2, cz - od / 2 + wt / 2, iw, down, wt, bc, Enum.Material.SmoothPlastic, "BasinBack")
	makeBox(sm, sCx, rimTop - down / 2, cz + od / 2 - wt / 2, iw, down, wt, bc, Enum.Material.SmoothPlastic, "BasinFront")
	makeBox(sm, sCx, botY + wt / 2, cz, iw, wt, od - 2 * wt, bc, Enum.Material.SmoothPlastic, "BasinBottom")
	if sink.faucet ~= false then
		local fz = wallZ - 0.35 -- behind the basin, between it and the backsplash
		makeCyl(sm, sCx, rimTop + 1.3, fz, 2.6, 0.22, "y", hw, Enum.Material.Metal, "FaucetRiser") -- slimmer, taller gooseneck
		makeCyl(sm, sCx, rimTop + 2.55, (fz + cz) / 2, cz - fz, 0.19, "z", hw, Enum.Material.Metal, "FaucetArm")
		makeCyl(sm, sCx, rimTop + 2.1, cz - 0.05, 1.0, 0.16, "y", hw, Enum.Material.Metal, "FaucetSpout")
		makeBall(sm, sCx, rimTop + 2.55, fz, 0.24, hw, Enum.Material.Metal, "FaucetElbow")
		makeBall(sm, sCx, rimTop + 2.55, cz - 0.05, 0.2, hw, Enum.Material.Metal, "FaucetBend")
	end
	sm.Parent = parent
	return sm
end

-- N interior shelf boards evenly spaced in a carcass opening (behind doors / inside
-- a fridge). Inset off the back + sides so they clear the door swing and back panel.
local function interiorShelves(model, cx, cz, w, depth, openBot, openTop, n, col, mat)
	n = math.floor(n or 0)
	if n < 1 then return end
	local gap = (openTop - openBot) / (n + 1)
	for i = 1, n do
		makeBox(model, cx, openBot + gap * i, cz + 0.2, w, 0.18, depth - 1.0, col, mat, "Shelf")
	end
end

-- spec.front = list of sections L->R, each { type = "drawers"|"doors", count, shelves }.
-- spec.sink = { width, depth, offset, basinDepth, basinColor, faucet } cuts a basin
-- hole through the countertop + carcass top so the basin isn't capped (see buildSink).
local function buildCabinet(spec)
	local cx, cyc, cz = spec.center[1], spec.center[2], spec.center[3]
	local W, H, D = spec.size[1], spec.size[2], spec.size[3]
	local wt = spec.thickness or 0.4
	local col = colorOf(spec.color, Color3.fromRGB(108, 78, 54))
	local mat = matOf(spec.material, Enum.Material.WoodPlanks)
	local hw = colorOf(spec.hardwareColor, Color3.fromRGB(156, 124, 66))
	local inner = colorOf(spec.interiorColor, Color3.fromRGB(64, 48, 38))
	local panelCol = colorOf(spec.panelColor, col:Lerp(Color3.fromRGB(255, 255, 255), 0.12))
	local style = spec.style -- "shaker" => frame+panel doors; else flat
	local toeH = spec.toeKick and 0.5 or 0
	local reveal = 0.06
	local model = getOrMakeModel(spec.parent, spec.name or "Cabinet")

	local botY, topY = cyc - H / 2, cyc + H / 2
	local frontZ = cz + D / 2
	local innerW = W - 2 * wt
	local carcassBot = botY + toeH
	local openBot, openTop = carcassBot + wt, topY - wt
	local openH = openTop - openBot

	-- sink cutout geometry, shared by the carcass Top split + the countertop frame so
	-- the basin drops THROUGH a real hole instead of being capped by counter/top blocks.
	local sink = spec.sink
	local sHx0, sHx1, sHz0, sHz1, sCx
	if sink then
		local sw = sink.width or math.min(innerW * 0.55, 6)
		local sd = sink.depth or math.max(2, D - 1.2)
		sCx = cx + (sink.offset or 0)
		sHx0, sHx1 = sCx - sw / 2, sCx + sw / 2
		sHz0, sHz1 = cz - sd / 2, cz + sd / 2
	end

	makeBox(model, cx - (W / 2 - wt / 2), (carcassBot + topY) / 2, cz, wt, topY - carcassBot, D, col, mat, "SideL")
	makeBox(model, cx + (W / 2 - wt / 2), (carcassBot + topY) / 2, cz, wt, topY - carcassBot, D, col, mat, "SideR")
	makeBox(model, cx, carcassBot + wt / 2, cz, innerW, wt, D, col, mat, "Bottom")
	if sink then
		-- split the top so the basin isn't capped by it
		local lw, rw = sHx0 - (cx - innerW / 2), (cx + innerW / 2) - sHx1
		if lw > 0.1 then makeBox(model, (cx - innerW / 2 + sHx0) / 2, topY - wt / 2, cz, lw, wt, D, col, mat, "TopL") end
		if rw > 0.1 then makeBox(model, (sHx1 + cx + innerW / 2) / 2, topY - wt / 2, cz, rw, wt, D, col, mat, "TopR") end
	else
		makeBox(model, cx, topY - wt / 2, cz, innerW, wt, D, col, mat, "Top")
	end
	if spec.back ~= false then
		makeBox(model, cx, (openBot + openTop) / 2, cz - D / 2 + wt / 2, innerW, openH, wt, col, mat, "Back")
	end
	if toeH > 0 then
		makeBox(model, cx, botY + toeH / 2, cz - 0.4, W - 0.8, toeH, D - 1.0, colorOf(spec.toeColor, Color3.fromRGB(38, 34, 38)), Enum.Material.Wood, "ToeKick")
	end
	if spec.countertop then
		local cc = colorOf(spec.counterColor, Color3.fromRGB(58, 56, 62))
		local cmat = matOf(spec.counterMaterial, Enum.Material.Slate)
		local cyT = topY + 0.22
		if sink then
			-- counter as a 4-strip frame around the basin hole (no slab over the basin)
			local cl, cr = cx - (W + 1) / 2, cx + (W + 1) / 2
			local cf, cb = cz - (D + 0.5) / 2, cz + (D + 0.5) / 2
			makeBox(model, (cl + sHx0) / 2, cyT, cz, sHx0 - cl, 0.44, D + 0.5, cc, cmat, "CounterL")
			makeBox(model, (sHx1 + cr) / 2, cyT, cz, cr - sHx1, 0.44, D + 0.5, cc, cmat, "CounterR")
			makeBox(model, sCx, cyT, (sHz1 + cb) / 2, sHx1 - sHx0, 0.44, cb - sHz1, cc, cmat, "CounterB")
			makeBox(model, sCx, cyT, (cf + sHz0) / 2, sHx1 - sHx0, 0.44, sHz0 - cf, cc, cmat, "CounterF")
		else
			makeBox(model, cx, cyT, cz, W + 1, 0.44, D + 0.5, cc, cmat, "Countertop")
		end
		if spec.bullnose then
			-- rounded front edge (KitchenUnit-style) — a cylinder nose along the counter front
			makeCyl(model, cx, cyT, cz + (D + 0.5) / 2, W + 1, 0.44, "x", cc, cmat, "Bullnose")
		end
		if spec.backsplash then
			makeBox(model, cx, topY + 1.29, cz - D / 2 - 0.15, W + 1, 1.7, 0.3, colorOf(spec.backsplashColor, Color3.fromRGB(150, 140, 122)), Enum.Material.Plaster, "Backsplash")
		end
	end
	if sink then
		buildSink(model, sCx, topY, cz, sHx1 - sHx0, sHz1 - sHz0, sHz0, sink, hw)
		if sink.apron then
			-- farmhouse apron: a big exposed basin front flush at the cabinet face (hero element)
			local aH = math.min(2.6, H * 0.5)
			makeBox(model, sCx, topY - aH / 2 + 0.1, cz + D / 2 + 0.06, sHx1 - sHx0 + 0.5, aH, 0.4, colorOf(sink.basinColor, Color3.fromRGB(236, 238, 240)), Enum.Material.SmoothPlastic, "SinkApron")
		end
	end

	local sections = spec.front or { { type = "doors", count = (W > 7 and 2 or 1) } }
	local nsec = #sections
	local stile = 0.3
	local secW = (innerW - stile * (nsec + 1)) / nsec
	for s = 0, nsec do
		local sx = cx - innerW / 2 + stile / 2 + s * (secW + stile)
		makeBox(model, sx, (openBot + openTop) / 2, frontZ - 0.12, stile, openH, 0.25, col, mat, "Stile")
	end
	for si, sec in ipairs(sections) do
		local secCx = cx - innerW / 2 + stile + (si - 1) * (secW + stile) + secW / 2
		if sec.type == "drawers" then
			local n = sec.count or 3
			local dh = (openH - reveal * (n + 1)) / n
			for i = 1, n do
				cabinetDrawer(model, secCx, openBot + reveal + dh / 2 + (i - 1) * (dh + reveal), secW - reveal, dh, frontZ, D, col, hw, inner)
			end
		else
			local n = sec.count or 2
			local dh, cyo = openH - 2 * reveal, (openBot + openTop) / 2
			if n <= 1 then
				local dw = secW - 2 * reveal
				cabinetDoor(model, secCx, cyo, dw, dh, frontZ, secCx - dw / 2, -100, col, hw, style, panelCol)
			else
				local dw = (secW - 3 * reveal) / 2
				local lcx, rcx = secCx - reveal / 2 - dw / 2, secCx + reveal / 2 + dw / 2
				cabinetDoor(model, lcx, cyo, dw, dh, frontZ, lcx - dw / 2, -100, col, hw, style, panelCol)
				cabinetDoor(model, rcx, cyo, dw, dh, frontZ, rcx + dw / 2, 100, col, hw, style, panelCol)
			end
			if sec.shelves then
				interiorShelves(model, secCx, cz, secW - 0.6, D, openBot, openTop, sec.shelves, col, mat)
			end
		end
	end

	local ctrl = Instance.new("Script"); ctrl.Name = "CabinetController"; ctrl.Source = CABINET_CONTROLLER; ctrl.Parent = model
	model.PrimaryPart = model:FindFirstChild("Bottom")
	return model
end

-- ---------- table / shelf / bed: clean joinery, textured-material defaults -----
local function buildTable(spec)
	local cx, cyc, cz = spec.center[1], spec.center[2], spec.center[3]
	local W, H, D = spec.size[1], spec.size[2], spec.size[3]
	local col = colorOf(spec.color, Color3.fromRGB(110, 80, 56))
	local mat = matOf(spec.material, Enum.Material.WoodPlanks)
	local model = getOrMakeModel(spec.parent, spec.name or "Table")
	local topThick = 0.4
	local topY = cyc + H / 2 - topThick / 2
	makeBox(model, cx, topY, cz, W, topThick, D, col, mat, "Top")
	if spec.bevel then bevelTopEdges(model, cx, topY + topThick / 2, cz, W, D, col, mat) end
	local legW = math.max(0.4, math.min(0.8, W * 0.1, D * 0.1))
	local inset = legW / 2 + 0.4
	local legBot, legTop = cyc - H / 2, topY - topThick / 2
	for _, sx in ipairs({ -1, 1 }) do
		for _, sz in ipairs({ -1, 1 }) do
			roundLeg(model, cx + sx * (W / 2 - inset), legBot, legTop, cz + sz * (D / 2 - inset), legW, col, mat)
		end
	end
	-- apron skirt under the top, inset from the edge, tying the legs together
	-- (learned from procedural-gen: tables read flimsy without it).
	local apY = legTop - 0.5
	local apIn = inset + 0.1
	makeBox(model, cx, apY, cz + D / 2 - apIn, W - 2 * apIn, 0.7, 0.15, col, mat, "Apron")
	makeBox(model, cx, apY, cz - D / 2 + apIn, W - 2 * apIn, 0.7, 0.15, col, mat, "Apron")
	makeBox(model, cx - W / 2 + apIn, apY, cz, 0.15, 0.7, D - 2 * apIn, col, mat, "Apron")
	makeBox(model, cx + W / 2 - apIn, apY, cz, 0.15, 0.7, D - 2 * apIn, col, mat, "Apron")
	model.PrimaryPart = model:FindFirstChild("Top")
	return model
end

local function buildShelf(spec)
	local cx, cyc, cz = spec.center[1], spec.center[2], spec.center[3]
	local W, H, D = spec.size[1], spec.size[2], spec.size[3]
	local wt = spec.thickness or 0.4
	local col = colorOf(spec.color, Color3.fromRGB(110, 80, 56))
	local mat = matOf(spec.material, Enum.Material.WoodPlanks)
	local model = getOrMakeModel(spec.parent, spec.name or "Shelf")
	local botY, topY = cyc - H / 2, cyc + H / 2
	local innerW = W - 2 * wt
	makeBox(model, cx - (W / 2 - wt / 2), cyc, cz, wt, H, D, col, mat, "SideL")
	makeBox(model, cx + (W / 2 - wt / 2), cyc, cz, wt, H, D, col, mat, "SideR")
	makeBox(model, cx, botY + wt / 2, cz, innerW, wt, D, col, mat, "Bottom")
	makeBox(model, cx, topY - wt / 2, cz, innerW, wt, D, col, mat, "Top")
	if spec.back ~= false then
		makeBox(model, cx, cyc, cz - D / 2 + wt / 2, innerW, H - 2 * wt, wt, col, mat, "Back")
	end
	local nshelf = math.max(0, math.floor(spec.shelves or 3))
	local openBot, openTop = botY + wt, topY - wt
	local gap = (openTop - openBot) / (nshelf + 1)
	for i = 1, nshelf do
		makeBox(model, cx, openBot + gap * i, cz + 0.3, innerW, wt * 0.6, D - 1, col, mat, "ShelfBoard")
	end
	model.PrimaryPart = model:FindFirstChild("Bottom")
	return model
end

local function buildBed(spec)
	local cx, cyc, cz = spec.center[1], spec.center[2], spec.center[3]
	local W, H, D = spec.size[1], spec.size[2], spec.size[3] -- D = bed length (head at -Z)
	local col = colorOf(spec.color, Color3.fromRGB(96, 66, 46))
	local mat = matOf(spec.material, Enum.Material.WoodPlanks)
	local matCol = colorOf(spec.mattressColor, Color3.fromRGB(224, 221, 212))
	local model = getOrMakeModel(spec.parent, spec.name or "Bed")
	local botY = cyc - H / 2
	local frameH = math.min(1.4, H * 0.45)
	local matH = math.min(1.2, H * 0.35)
	makeBox(model, cx, botY + frameH / 2, cz, W, frameH, D, col, mat, "Frame")
	makeBox(model, cx, botY + frameH + matH / 2, cz, W - 0.4, matH, D - 0.4, matCol, Enum.Material.Fabric, "Mattress")
	-- framed-and-panel headboard (procedural-gen style: 2 posts + top/bottom rails +
	-- a recessed center panel) instead of a flat slab. Head at -Z.
	local hz = cz - D / 2 - 0.2
	local hbTop, hbBot = botY + H, botY + frameH + matH * 0.3
	local postW, railT = 0.4, 0.5
	for _, sx in ipairs({ -1, 1 }) do
		makeBox(model, cx + sx * (W / 2 - postW / 2), (hbBot + hbTop) / 2, hz, postW, hbTop - hbBot, 0.4, col, mat, "HeadboardPost")
	end
	makeBox(model, cx, hbTop - railT / 2, hz, W - 2 * postW, railT, 0.4, col, mat, "HeadboardTopRail")
	makeBox(model, cx, hbBot + 0.2, hz, W - 2 * postW, 0.4, 0.4, col, mat, "HeadboardBotRail")
	makeBox(model, cx, (hbBot + 0.4 + hbTop - railT) / 2, hz - 0.05, W - 2 * postW, (hbTop - railT) - (hbBot + 0.4), 0.25, colorOf(spec.panelColor, col:Lerp(Color3.fromRGB(255, 255, 255), 0.08)), mat, "HeadboardPanel")
	-- footboard at the foot (+Z), lower than the headboard
	makeBox(model, cx, botY + frameH + 0.5, cz + D / 2 + 0.1, W, 1.2, 0.35, col, mat, "Footboard")
	makeBox(model, cx, botY + frameH + matH + 0.2, cz - D / 2 + 1.6, W - 1.6, 0.5, 1.8, colorOf(spec.pillowColor, Color3.fromRGB(240, 238, 232)), Enum.Material.Fabric, "Pillow")
	model.PrimaryPart = model:FindFirstChild("Frame")
	return model
end

-- ---------- shared carcass + controller (reused by storage furniture) --------
-- 5-panel box (sides full height, top/bottom/back butt BETWEEN them). Returns the
-- open interior bounds so callers can lay drawers/doors. Front = +Z.
local function carcass(model, cx, cyc, cz, W, H, D, wt, col, mat)
	local botY, topY = cyc - H / 2, cyc + H / 2
	local innerW = W - 2 * wt
	makeBox(model, cx - (W / 2 - wt / 2), cyc, cz, wt, H, D, col, mat, "SideL")
	makeBox(model, cx + (W / 2 - wt / 2), cyc, cz, wt, H, D, col, mat, "SideR")
	makeBox(model, cx, botY + wt / 2, cz, innerW, wt, D, col, mat, "Bottom")
	makeBox(model, cx, topY - wt / 2, cz, innerW, wt, D, col, mat, "Top")
	makeBox(model, cx, cyc, cz - D / 2 + wt / 2, innerW, H - 2 * wt, wt, col, mat, "Back")
	return botY + wt, topY - wt, innerW, cz + D / 2 -- openBot, openTop, innerW, frontZ
end

local function addController(model)
	local s = Instance.new("Script"); s.Name = "CabinetController"; s.Source = CABINET_CONTROLLER; s.Parent = model
end

-- ---------- house furniture set (clean joinery, textured defaults, +Z front) --
local function buildChair(spec)
	local cx, cyc, cz = spec.center[1], spec.center[2], spec.center[3]
	local W, H, D = spec.size[1], spec.size[2], spec.size[3]
	local col = colorOf(spec.color, Color3.fromRGB(110, 80, 56))
	local mat = matOf(spec.material, Enum.Material.WoodPlanks)
	local model = getOrMakeModel(spec.parent, spec.name or "Chair")
	local botY = cyc - H / 2
	local seatH = math.min(2.0, H * 0.42)
	local legW = 0.4
	makeBox(model, cx, botY + seatH, cz, W, 0.3, D, col, mat, "Seat")
	for _, sx in ipairs({ -1, 1 }) do
		for _, sz in ipairs({ -1, 1 }) do
			roundLeg(model, cx + sx * (W / 2 - legW / 2 - 0.1), botY, botY + seatH, cz + sz * (D / 2 - legW / 2 - 0.1), legW, col, mat)
		end
	end
	-- slatted back: 2 posts + top rail + a LOWER rail that sits on the seat back, with
	-- vertical slats butting BOTH rails (so they reach the bottom — no floating slats).
	-- rails span between the posts; everything connects seat->lower rail->slats->top rail.
	local bz = cz - D / 2 + 0.25
	local px = W / 2 - legW / 2 - 0.1
	for _, sx in ipairs({ -1, 1 }) do
		roundLeg(model, cx + sx * px, botY + seatH, botY + H, bz, legW, col, mat, "BackPost")
	end
	local backW = 2 * px - legW -- span between the posts (butt their inner faces)
	local railTopY = botY + H - 0.3
	local railBotY = botY + seatH + 0.3 -- 0.3-tall rail; its bottom meets the seat top
	makeBox(model, cx, railTopY, bz, backW, 0.4, 0.18, col, mat, "TopRail")
	makeBox(model, cx, railBotY, bz, backW, 0.3, 0.18, col, mat, "LowerRail")
	local slatBot, slatTop = railBotY + 0.1, railTopY - 0.15
	local nslat = 4
	for i = 1, nslat - 1 do
		makeBox(model, cx - backW / 2 + (backW / nslat) * i, (slatBot + slatTop) / 2, bz, 0.18, slatTop - slatBot, 0.12, col, mat, "Slat")
	end
	-- aprons: thin rails under the seat tying the legs together (procedural-gen style)
	local apY = botY + seatH - 0.4
	makeBox(model, cx, apY, cz + D / 2 - 0.45, W - 0.7, 0.3, 0.12, col, mat, "Apron")
	makeBox(model, cx, apY, cz - D / 2 + 0.45, W - 0.7, 0.3, 0.12, col, mat, "Apron")
	makeBox(model, cx - W / 2 + 0.45, apY, cz, 0.12, 0.3, D - 0.7, col, mat, "Apron")
	makeBox(model, cx + W / 2 - 0.45, apY, cz, 0.12, 0.3, D - 0.7, col, mat, "Apron")
	makeBox(model, cx, botY + seatH + 0.2, cz + 0.1, W - 0.4, 0.22, D - 0.5, colorOf(spec.cushionColor, Color3.fromRGB(120, 110, 96)), Enum.Material.Fabric, "SeatCushion")
	-- NOTE: kept the chair a clean slat-back (seat+cushion / 4 legs / 2 posts / top rail
	-- + slats / aprons). Removed the blind-added finials+stretchers — mixing rustic
	-- (finials/stretchers) with formal (aprons/slats) read as an incoherent frankenchair.
	addSitSeat(model, cx, cz + 0.1, W - 0.6, D - 0.7, botY + seatH + 0.15) -- sittable
	model.PrimaryPart = model:FindFirstChild("Seat")
	return model
end

-- sofa (seats=3) / armchair (seats=1): upholstered base + back + arms + cushions.
local function buildSeating(spec, seats)
	local cx, cyc, cz = spec.center[1], spec.center[2], spec.center[3]
	local W, H, D = spec.size[1], spec.size[2], spec.size[3]
	local fcol = colorOf(spec.color, Color3.fromRGB(70, 74, 82))
	local fmat = matOf(spec.material, Enum.Material.Fabric)
	local ccol = colorOf(spec.cushionColor, fcol:Lerp(Color3.fromRGB(255, 255, 255), 0.08))
	local model = getOrMakeModel(spec.parent, spec.name or (seats > 1 and "Sofa" or "Armchair"))
	local botY = cyc - H / 2
	local baseH = H * 0.45
	local armH = H * 0.66
	-- arms are the OUTER frame; base + back + cushions fit BETWEEN them (butt joints,
	-- no coplanar outer faces / no deep overlap — the old version buried the base).
	local armW = 0.8
	local innerW = W - 2 * armW
	-- arms get a ROLLED top (cylinder along the arm + a ball front cap) — procedural-
	-- gen technique, reads far softer than a square arm; no CSG needed.
	for _, sx in ipairs({ -1, 1 }) do
		local ax = cx + sx * (W - armW) / 2
		makeBox(model, ax, botY + armH / 2, cz + 0.2, armW, armH, D - 0.4, fcol, fmat, "Arm")
		makeCyl(model, ax, botY + armH, cz + 0.2, D - 0.4, armW, "z", fcol, fmat, "ArmRoll")
		makeBall(model, ax, botY + armH, cz + (D - 0.4) / 2 + 0.2, armW, fcol, fmat, "ArmRollCap")
	end
	makeBox(model, cx, botY + baseH / 2, cz, innerW, baseH, D, fcol, fmat, "Base")
	makeBox(model, cx, botY + H / 2, cz - D / 2 + 0.4, innerW, H, 0.8, fcol, fmat, "Back")
	local cw = innerW / seats
	for i = 1, seats do
		local scx = cx - innerW / 2 + cw / 2 + (i - 1) * cw
		makeBox(model, scx, botY + baseH + 0.35, cz + 0.5, cw - 0.25, 0.7, D - 1.4, ccol, fmat, "SeatCushion")
		makeBox(model, scx, botY + baseH + 1.1, cz - D / 2 + 1.0, cw - 0.55, H - baseH - 0.5, 0.6, ccol, fmat, "BackCushion")
	end
	-- throw pillows at the back corners (sofas only)
	if seats > 1 then
		for _, sx in ipairs({ -1, 1 }) do
			makeBox(model, cx + sx * innerW * 0.32, botY + baseH + 1.0, cz - D / 2 + 1.35, 1.3, 1.3, 0.4, colorOf(spec.pillowColor, ccol:Lerp(Color3.fromRGB(40, 40, 50), 0.35)), fmat, "ThrowPillow")
		end
	end
	addSitSeat(model, cx, cz + 0.4, innerW - 0.4, D - 1.6, botY + baseH + 0.7) -- sittable
	model.PrimaryPart = model:FindFirstChild("Base")
	return model
end

local function buildNightstand(spec)
	local cx, cyc, cz = spec.center[1], spec.center[2], spec.center[3]
	local W, H, D = spec.size[1], spec.size[2], spec.size[3]
	local wt = spec.thickness or 0.4
	local col = colorOf(spec.color, Color3.fromRGB(110, 80, 56))
	local mat = matOf(spec.material, Enum.Material.WoodPlanks)
	local hw = colorOf(spec.hardwareColor, Color3.fromRGB(156, 124, 66))
	local inner = colorOf(spec.interiorColor, Color3.fromRGB(64, 48, 38))
	local model = getOrMakeModel(spec.parent, spec.name or "Nightstand")
	local openBot, openTop, innerW, frontZ = carcass(model, cx, cyc, cz, W, H, D, wt, col, mat)
	local n, reveal = math.max(1, math.floor(spec.drawers or 2)), 0.06
	local dh = (openTop - openBot - reveal * (n + 1)) / n
	for i = 1, n do
		cabinetDrawer(model, cx, openBot + reveal + dh / 2 + (i - 1) * (dh + reveal), innerW - reveal, dh, frontZ, D, col, hw, inner)
	end
	addController(model)
	model.PrimaryPart = model:FindFirstChild("Bottom")
	return model
end

local function buildDresser(spec)
	local cx, cyc, cz = spec.center[1], spec.center[2], spec.center[3]
	local W, H, D = spec.size[1], spec.size[2], spec.size[3]
	local wt = spec.thickness or 0.4
	local col = colorOf(spec.color, Color3.fromRGB(110, 80, 56))
	local mat = matOf(spec.material, Enum.Material.WoodPlanks)
	local hw = colorOf(spec.hardwareColor, Color3.fromRGB(156, 124, 66))
	local inner = colorOf(spec.interiorColor, Color3.fromRGB(64, 48, 38))
	local model = getOrMakeModel(spec.parent, spec.name or "Dresser")
	local openBot, openTop, innerW, frontZ = carcass(model, cx, cyc, cz, W, H, D, wt, col, mat)
	local cols = math.max(1, math.floor(spec.columns or 2))
	local rows = math.max(1, math.floor(spec.rows or 3))
	local stile, reveal = 0.3, 0.06
	local secW = (innerW - stile * (cols + 1)) / cols
	for s = 0, cols do
		makeBox(model, cx - innerW / 2 + stile / 2 + s * (secW + stile), (openBot + openTop) / 2, frontZ - 0.12, stile, openTop - openBot, 0.25, col, mat, "Stile")
	end
	local dh = (openTop - openBot - reveal * (rows + 1)) / rows
	for c = 1, cols do
		local secCx = cx - innerW / 2 + stile + (c - 1) * (secW + stile) + secW / 2
		for i = 1, rows do
			cabinetDrawer(model, secCx, openBot + reveal + dh / 2 + (i - 1) * (dh + reveal), secW - reveal, dh, frontZ, D, col, hw, inner)
		end
	end
	-- overhanging top cap (procedural-gen: case goods have a top that overhangs the body)
	makeBox(model, cx, cyc + H / 2 + 0.2, cz, W + 0.8, 0.4, D + 0.4, col, mat, "TopCap")
	if spec.plinth then plinthBase(model, cx, cz, W, D, cyc - H / 2, col, mat) end
	addController(model)
	model.PrimaryPart = model:FindFirstChild("Bottom")
	return model
end

local function buildWardrobe(spec)
	local cx, cyc, cz = spec.center[1], spec.center[2], spec.center[3]
	local W, H, D = spec.size[1], spec.size[2], spec.size[3]
	local wt = spec.thickness or 0.4
	local col = colorOf(spec.color, Color3.fromRGB(110, 80, 56))
	local mat = matOf(spec.material, Enum.Material.WoodPlanks)
	local hw = colorOf(spec.hardwareColor, Color3.fromRGB(156, 124, 66))
	local style = spec.style
	local panelCol = colorOf(spec.panelColor, col:Lerp(Color3.fromRGB(255, 255, 255), 0.12))
	local model = getOrMakeModel(spec.parent, spec.name or "Wardrobe")
	local openBot, openTop, innerW, frontZ = carcass(model, cx, cyc, cz, W, H, D, wt, col, mat)
	local reveal = 0.06
	local dh, cyo = openTop - openBot - 2 * reveal, (openBot + openTop) / 2
	local dw = (innerW - 3 * reveal) / 2
	local lcx, rcx = cx - reveal / 2 - dw / 2, cx + reveal / 2 + dw / 2
	cabinetDoor(model, lcx, cyo, dw, dh, frontZ, lcx - dw / 2, -100, col, hw, style, panelCol)
	cabinetDoor(model, rcx, cyo, dw, dh, frontZ, rcx + dw / 2, 100, col, hw, style, panelCol)
	makeCyl(model, cx, openTop - 0.8, cz, innerW - 0.6, 0.18, "x", hw, Enum.Material.Metal, "Rail")
	makeBox(model, cx, openTop - 1.3, cz, innerW, 0.3, D - 1.0, col, mat, "ShelfBoard")
	-- cornice cap overhanging the top (procedural-gen: case goods read better with a cap)
	makeBox(model, cx, cyc + H / 2 + 0.2, cz, W + 0.6, 0.4, D + 0.4, col, mat, "Cornice")
	addController(model)
	model.PrimaryPart = model:FindFirstChild("Bottom")
	return model
end

local function buildDesk(spec)
	local cx, cyc, cz = spec.center[1], spec.center[2], spec.center[3]
	local W, H, D = spec.size[1], spec.size[2], spec.size[3]
	local wt = spec.thickness or 0.4
	local col = colorOf(spec.color, Color3.fromRGB(110, 80, 56))
	local mat = matOf(spec.material, Enum.Material.WoodPlanks)
	local hw = colorOf(spec.hardwareColor, Color3.fromRGB(156, 124, 66))
	local inner = colorOf(spec.interiorColor, Color3.fromRGB(64, 48, 38))
	local model = getOrMakeModel(spec.parent, spec.name or "Desk")
	local topThick = 0.4
	local topY = cyc + H / 2 - topThick / 2
	makeBox(model, cx, topY, cz, W, topThick, D, col, mat, "Top")
	local pedW = math.min(W * 0.32, 3)
	local pedCx = cx + W / 2 - pedW / 2 - 0.1
	local pedTopY, pedBotY = topY - topThick / 2, cyc - H / 2
	local pedCyc = (pedTopY + pedBotY) / 2
	local oB, oT, pInner, pFrontZ = carcass(model, pedCx, pedCyc, cz, pedW, pedTopY - pedBotY, D, wt, col, mat)
	local n, reveal = 2, 0.06
	local dh = (oT - oB - reveal * (n + 1)) / n
	for i = 1, n do
		cabinetDrawer(model, pedCx, oB + reveal + dh / 2 + (i - 1) * (dh + reveal), pInner - reveal, dh, pFrontZ, D, col, hw, inner)
	end
	local legW = 0.5
	for _, sz in ipairs({ -1, 1 }) do
		roundLeg(model, cx - W / 2 + 0.6, pedBotY, pedTopY, cz + sz * (D / 2 - 0.6), legW, col, mat)
	end
	addController(model)
	model.PrimaryPart = model:FindFirstChild("Top")
	return model
end

local function buildFridge(spec)
	local cx, cyc, cz = spec.center[1], spec.center[2], spec.center[3]
	local W, H, D = spec.size[1], spec.size[2], spec.size[3]
	local wt = spec.thickness or 0.4
	local col = colorOf(spec.color, Color3.fromRGB(214, 217, 221))
	local mat = matOf(spec.material, Enum.Material.SmoothPlastic)
	local hw = colorOf(spec.hardwareColor, Color3.fromRGB(120, 122, 128))
	local model = getOrMakeModel(spec.parent, spec.name or "Fridge")
	local openBot, openTop, innerW, frontZ = carcass(model, cx, cyc, cz, W, H, D, wt, col, mat)
	local reveal = 0.05
	local splitY = openBot + (openTop - openBot) * 0.62
	local dw = innerW - reveal
	cabinetDoor(model, cx, (openBot + splitY) / 2, dw, splitY - openBot - reveal, frontZ, cx - dw / 2, -100, col, hw, nil, nil)
	cabinetDoor(model, cx, (splitY + openTop) / 2, dw, openTop - splitY - reveal, frontZ, cx - dw / 2, -100, col, hw, nil, nil)
	-- fridge/freezer divider + interior shelves (visible when the doors open)
	local shelfCol = colorOf(spec.shelfColor, Color3.fromRGB(226, 229, 233))
	makeBox(model, cx, splitY, cz, innerW, 0.3, D - 0.4, col, mat, "Divider")
	interiorShelves(model, cx, cz, innerW - 0.4, D, openBot + 0.3, splitY - 0.3, math.floor(spec.shelves or 3), shelfCol, Enum.Material.SmoothPlastic)
	interiorShelves(model, cx, cz, innerW - 0.4, D, splitY + 0.3, openTop - 0.3, 1, shelfCol, Enum.Material.SmoothPlastic)
	addController(model)
	model.PrimaryPart = model:FindFirstChild("Bottom")
	return model
end

local function buildStove(spec)
	local cx, cyc, cz = spec.center[1], spec.center[2], spec.center[3]
	local W, H, D = spec.size[1], spec.size[2], spec.size[3]
	local wt = spec.thickness or 0.4
	local col = colorOf(spec.color, Color3.fromRGB(62, 62, 68))
	local mat = matOf(spec.material, Enum.Material.SmoothPlastic)
	local hw = colorOf(spec.hardwareColor, Color3.fromRGB(150, 152, 158))
	local model = getOrMakeModel(spec.parent, spec.name or "Stove")
	local openBot, openTop, innerW, frontZ = carcass(model, cx, cyc, cz, W, H, D, wt, col, mat)
	local topY = cyc + H / 2
	makeBox(model, cx, topY + 0.15, cz + 0.3, W, 0.3, D - 0.6, colorOf(spec.cooktopColor, Color3.fromRGB(38, 38, 42)), Enum.Material.Metal, "Cooktop")
	for _, sx in ipairs({ -1, 1 }) do
		for _, sz in ipairs({ -1, 1 }) do
			makeCyl(model, cx + sx * W * 0.22, topY + 0.32, cz + 0.3 + sz * (D - 0.6) * 0.22, 0.14, 1.1, "y", Color3.fromRGB(22, 22, 24), Enum.Material.Metal, "Burner")
		end
	end
	-- dark oven cavity liner (reads as a real oven interior when the door opens) — procedural-gen
	makeBox(model, cx, (openBot + openTop) / 2, cz + 0.2, innerW - 0.3, openTop - openBot - 0.3, D - 1.2, Color3.fromRGB(20, 20, 22), Enum.Material.SmoothPlastic, "OvenInterior")
	cabinetDoor(model, cx, (openBot + openTop) / 2, innerW - 0.1, openTop - openBot - 0.1, frontZ, cx - (innerW - 0.1) / 2, -100, col, hw, nil, nil)
	makeBox(model, cx, topY + 1.0, cz - D / 2 + 0.2, W, 1.6, 0.3, col, mat, "Backguard")
	for i = 0, 3 do
		makeCyl(model, cx - W * 0.32 + i * (W * 0.21), topY + 1.0, cz - D / 2 + 0.05, 0.34, 0.42, "z", hw, Enum.Material.Metal, "Knob")
	end
	-- vintage range stands on metal feet
	local botY = cyc - H / 2
	for _, sx in ipairs({ -1, 1 }) do
		for _, sz in ipairs({ -1, 1 }) do
			makeBox(model, cx + sx * (W / 2 - 0.5), botY - 0.3, cz + sz * (D / 2 - 0.5), 0.5, 0.6, 0.5, hw, Enum.Material.Metal, "Foot")
		end
	end
	addController(model)
	model.PrimaryPart = model:FindFirstChild("Bottom")
	return model
end

local function buildToilet(spec)
	local cx, cyc, cz = spec.center[1], spec.center[2], spec.center[3]
	local W, H, D = spec.size[1], spec.size[2], spec.size[3]
	local pcol = colorOf(spec.color, Color3.fromRGB(238, 238, 240))
	local pmat = matOf(spec.material, Enum.Material.SmoothPlastic)
	local model = getOrMakeModel(spec.parent, spec.name or "Toilet")
	local f = cyc - H / 2 -- floor
	makeBox(model, cx, f + 0.7, cz + 0.1, 1.4, 1.4, 1.8, pcol, pmat, "Pedestal")
	makeBox(model, cx, f + 1.8, cz + 0.3, 2.2, 0.8, 2.6, pcol, pmat, "Bowl")
	makeBox(model, cx, f + 2.29, cz + 0.3, 2.3, 0.18, 2.7, pcol, pmat, "Seat")
	makeBox(model, cx, f + 2.7, cz - D / 2 + 0.6, 2.4, 2.0, 1.0, pcol, pmat, "Tank") -- bottom above bowl's, rests on its back (no coplanar z-fight)
	makeBox(model, cx, f + 3.85, cz - D / 2 + 0.6, 2.5, 0.3, 1.1, pcol, pmat, "TankLid")
	model.PrimaryPart = model:FindFirstChild("Bowl")
	return model
end

local function buildBathtub(spec)
	local cx, cyc, cz = spec.center[1], spec.center[2], spec.center[3]
	local W, H, D = spec.size[1], spec.size[2], spec.size[3] -- D = tub length
	local pcol = colorOf(spec.color, Color3.fromRGB(238, 238, 240))
	local pmat = matOf(spec.material, Enum.Material.SmoothPlastic)
	local hw = colorOf(spec.hardwareColor, Color3.fromRGB(150, 152, 158))
	local model = getOrMakeModel(spec.parent, spec.name or "Bathtub")
	local botY = cyc - H / 2
	local t = 0.4
	-- carcass pattern: L/R sides are the frame; ends + floor butt BETWEEN them (no
	-- coplanar outer faces -> kills the 8 self z-fights the naive open-box had).
	local iw, id = W - 2 * t, D - 2 * t
	makeBox(model, cx - W / 2 + t / 2, cyc, cz, t, H, D, pcol, pmat, "TubSideL")
	makeBox(model, cx + W / 2 - t / 2, cyc, cz, t, H, D, pcol, pmat, "TubSideR")
	makeBox(model, cx, cyc, cz - D / 2 + t / 2, iw, H, t, pcol, pmat, "TubEndBack")
	makeBox(model, cx, cyc, cz + D / 2 - t / 2, iw, H, t, pcol, pmat, "TubEndFront")
	makeBox(model, cx, botY + t / 2, cz, iw, t, id, pcol, pmat, "TubFloor")
	-- rounded gooseneck faucet at the back-left corner
	makeCyl(model, cx, cyc + H / 2 + 0.5, cz - D / 2 + 0.6, 1.0, 0.28, "y", hw, Enum.Material.Metal, "FaucetRiser")
	makeCyl(model, cx, cyc + H / 2 + 0.95, cz - D / 2 + 1.05, 1.1, 0.22, "z", hw, Enum.Material.Metal, "FaucetSpout")
	makeBall(model, cx, cyc + H / 2 + 0.95, cz - D / 2 + 0.6, 0.3, hw, Enum.Material.Metal, "FaucetBend")
	-- rolled rim around the top + claw feet (procedural-gen clawfoot style) — the rim
	-- is 4 cylinders along the top edges; each foot = a ball paw on a short metal leg.
	local rimY = cyc + H / 2
	makeCyl(model, cx, rimY, cz - D / 2 + t / 2, W, 0.45, "x", pcol, pmat, "RolledRimBack")
	makeCyl(model, cx, rimY, cz + D / 2 - t / 2, W, 0.45, "x", pcol, pmat, "RolledRimFront")
	makeCyl(model, cx - W / 2 + t / 2, rimY, cz, D, 0.45, "z", pcol, pmat, "RolledRimL")
	makeCyl(model, cx + W / 2 - t / 2, rimY, cz, D, 0.45, "z", pcol, pmat, "RolledRimR")
	for _, sx in ipairs({ -1, 1 }) do
		for _, sz in ipairs({ -1, 1 }) do
			local fx, fz = cx + sx * (W / 2 - 0.5), cz + sz * (D / 2 - 0.9)
			makeBox(model, fx, botY - 0.2, fz, 0.4, 0.7, 0.4, hw, Enum.Material.Metal, "FootLeg")
			makeBall(model, fx, botY - 0.55, fz, 0.6, hw, Enum.Material.Metal, "FootPaw")
		end
	end
	model.PrimaryPart = model:FindFirstChild("TubFloor")
	return model
end

-- kind -> builder, used by handlers.build AND regenBuildKit (in-place rebuild).
BUILDERS = {
	cabinet = buildCabinet, table = buildTable, shelf = buildShelf, bed = buildBed, chair = buildChair,
	sofa = function(s) return buildSeating(s, math.max(2, math.floor(s.seats or 3))) end,
	armchair = function(s) return buildSeating(s, 1) end,
	desk = buildDesk, nightstand = buildNightstand, dresser = buildDresser, wardrobe = buildWardrobe,
	fridge = buildFridge, stove = buildStove, toilet = buildToilet, bathtub = buildBathtub, prop = buildProp,
}

-- Rebuild a tagged piece IN PLACE from its current attributes (size/color/center from
-- live attributes, nested fields from BuildKitSpec). Clears old geometry, builds into
-- the same model so identity/selection + the attributes survive.
regenBuildKit = function(model)
	local kind = model:GetAttribute("BuildKitKind")
	local fn = BUILDERS[kind]
	if not fn or _regenBusy[model] then return end
	local spec = {}
	local json = model:GetAttribute("BuildKitSpec")
	if json then
		local ok, d = pcall(function() return HttpService:JSONDecode(json) end)
		if ok and type(d) == "table" then spec = d end
	end
	local w, h, dp = model:GetAttribute("Width"), model:GetAttribute("Height"), model:GetAttribute("Depth")
	if w and h and dp then spec.size = { w, h, dp } end
	local sc = model:GetAttribute("Scale")
	if type(sc) == "number" then spec.scale = sc end
	local col = model:GetAttribute("Color")
	if typeof(col) == "Color3" then
		spec.color = { math.floor(col.R * 255 + 0.5), math.floor(col.G * 255 + 0.5), math.floor(col.B * 255 + 0.5) }
	end
	local cf = model:GetPivot()
	spec.center = { cf.Position.X, cf.Position.Y, cf.Position.Z }
	spec.parent, spec.name = nil, model.Name
	_regenBusy[model] = true
	recorded("BuildKit regen " .. tostring(kind), function()
		for _, c in ipairs(model:GetChildren()) do
			c:Destroy()
		end
		_regenTarget = model
		pcall(fn, spec)
		_regenTarget = nil
	end)
	_regenBusy[model] = false
end

-- ---------- GUI builder ------------------------------------------------------
-- Builds a styled ScreenGui from a component tree. Theme tokens (sent fully
-- resolved by the Node side) drive corner/stroke/gradient/padding/font/color so
-- output is never bare. Components: panel, label, button, bar, list, grid, icon,
-- input, divider, spacer. ponytail: drop shadows skipped (layout tangle) — palette
-- + stroke + gradient carry depth; add via outer/inner frame pattern if needed.
local GUI_DEFAULT_THEME = {
	palette = {
		bg = { 18, 18, 22 }, surface = { 30, 30, 38 }, surfaceAlt = { 42, 42, 52 },
		accent = { 212, 175, 55 }, accentText = { 18, 18, 22 },
		text = { 235, 235, 240 }, textMuted = { 150, 150, 165 }, stroke = { 90, 90, 105 },
		success = { 120, 190, 120 }, danger = { 200, 90, 80 }, warning = { 220, 180, 90 },
	},
	font = {
		title = "Oswald", titleSize = 30, heading = "GothamBold", headingSize = 22,
		body = "Gotham", bodySize = 16, caption = "Gotham", captionSize = 13,
	},
	shape = { corner = 4, stroke = 1, strokeTransparency = 0.2, padding = 14, gap = 10 },
	effects = { gradient = 0.1, gradientRotation = 90, shadow = true },
}

local function gmerge(base, over)
	over = over or {}
	local out = {}
	for k, v in pairs(base) do
		local ov = over[k]
		if type(v) == "table" and type(ov) == "table" then
			out[k] = gmerge(v, ov)
		elseif ov ~= nil then
			out[k] = ov
		else
			out[k] = v
		end
	end
	for k, v in pairs(over) do
		if out[k] == nil then
			out[k] = v
		end
	end
	return out
end

local function col(c, fallback)
	if type(c) == "table" and #c == 3 then
		return Color3.fromRGB(c[1], c[2], c[3])
	end
	return fallback
end
local function pcol(theme, key)
	return col(theme.palette[key], Color3.fromRGB(255, 0, 255))
end
local function fontOf(name, fallback)
	if name then
		local ok, f = pcall(function()
			return Enum.Font[name]
		end)
		if ok and f then
			return f
		end
	end
	return fallback or Enum.Font.Gotham
end

local function addCorner(inst, r)
	local c = Instance.new("UICorner")
	c.CornerRadius = UDim.new(0, r or 0)
	c.Parent = inst
end
local function addStroke(inst, color, thickness, transparency)
	local s = Instance.new("UIStroke")
	s.Color = color
	s.Thickness = thickness or 1
	s.Transparency = transparency or 0
	s.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	s.Parent = inst
end
local function addPadding(inst, p)
	local u = Instance.new("UIPadding")
	local d = UDim.new(0, p)
	u.PaddingTop, u.PaddingBottom, u.PaddingLeft, u.PaddingRight = d, d, d, d
	u.Parent = inst
end
local function addGradient(inst, intensity, rotation)
	if not intensity or intensity <= 0 then
		return
	end
	local lo = 1 - intensity
	local g = Instance.new("UIGradient")
	g.Color = ColorSequence.new({
		ColorSequenceKeypoint.new(0, Color3.new(1, 1, 1)),
		ColorSequenceKeypoint.new(1, Color3.new(lo, lo, lo)),
	})
	g.Rotation = rotation or 90
	g.Parent = inst
end
local function addList(container, dir, gap, align)
	local l = Instance.new("UIListLayout")
	l.FillDirection = (dir == "horizontal") and Enum.FillDirection.Horizontal or Enum.FillDirection.Vertical
	l.Padding = UDim.new(0, gap or 0)
	l.SortOrder = Enum.SortOrder.LayoutOrder
	l.HorizontalAlignment = (align == "center" and Enum.HorizontalAlignment.Center)
		or (align == "right" and Enum.HorizontalAlignment.Right)
		or Enum.HorizontalAlignment.Left
	l.VerticalAlignment = Enum.VerticalAlignment.Top
	l.Parent = container
end

local function axisDim(tok, default)
	if not tok then
		return default
	end
	tok = tostring(tok)
	if tok == "auto" then
		return UDim.new(0, 0)
	end
	local pct = string.match(tok, "^(%-?%d+%.?%d*)%%$")
	if pct then
		return UDim.new(tonumber(pct) / 100, 0)
	end
	local n = tonumber(tok)
	if n then
		return UDim.new(0, n)
	end
	return default
end
local function parseSize(size)
	if not size then
		return nil, false, false
	end
	size = tostring(size)
	if size == "fill" then
		return UDim2.new(1, 0, 1, 0), false, false
	end
	local w, h = string.match(size, "^%s*([^,]+)%s*,%s*([^,]+)%s*$")
	if not w then
		return nil, false, false
	end
	local autoX, autoY = (w == "auto"), (h == "auto")
	local wd = axisDim(w, UDim.new(0, 100))
	local hd = axisDim(h, UDim.new(0, 100))
	return UDim2.new(wd.Scale, wd.Offset, hd.Scale, hd.Offset), autoX, autoY
end

local ANCHORS = {
	center = { 0.5, 0.5 }, top = { 0.5, 0 }, bottom = { 0.5, 1 },
	left = { 0, 0.5 }, right = { 1, 0.5 },
	topleft = { 0, 0 }, topright = { 1, 0 }, bottomleft = { 0, 1 }, bottomright = { 1, 1 },
}
local function xy(str)
	local x, y = string.match(tostring(str or ""), "^%s*(%-?%d+%.?%d*)%s*,%s*(%-?%d+%.?%d*)%s*$")
	if x then
		return tonumber(x), tonumber(y)
	end
	return nil
end
local function applyPlacement(inst, node, inLayout)
	if inLayout then
		return
	end
	local px, py = xy(node.position)
	if px then
		inst.AnchorPoint = Vector2.new(0, 0)
		inst.Position = UDim2.fromOffset(px, py)
		return
	end
	local a = ANCHORS[node.anchor or "center"]
	if a then
		inst.AnchorPoint = Vector2.new(a[1], a[2])
		local ox, oy = xy(node.offset)
		inst.Position = UDim2.new(a[1], ox or 0, a[2], oy or 0)
	end
end

local buildNode

local function applyChildren(container, node, theme)
	local layoutDir = node.fill
	if node.title and not layoutDir then
		layoutDir = "vertical"
	end
	if layoutDir then
		addList(container, layoutDir, node.gap or theme.shape.gap, node.align)
	end
	if node.title then
		local t = Instance.new("TextLabel")
		t.Name = "Title"
		t.BackgroundTransparency = 1
		t.Size = UDim2.new(1, 0, 0, theme.font.headingSize + 6)
		t.Font = fontOf(theme.font.heading)
		t.TextSize = theme.font.headingSize
		t.TextColor3 = pcol(theme, "text")
		t.Text = node.title
		t.TextXAlignment = Enum.TextXAlignment.Left
		t.LayoutOrder = -1
		t.Parent = container
	end
	if node.children then
		local order = 0
		for _, child in ipairs(node.children) do
			local inst = buildNode(child, theme, layoutDir)
			if inst then
				order += 1
				inst.LayoutOrder = order
				inst.Parent = container
			end
		end
	end
end

function buildNode(node, theme, layoutDir)
	local inLayout = (layoutDir ~= nil and layoutDir ~= false)
	local t = node.type
	local inst

	if t == "label" then
		inst = Instance.new("TextLabel")
		inst.BackgroundTransparency = 1
		local variant = node.variant or "body"
		local fsize = node.textSize or theme.font[variant .. "Size"] or theme.font.bodySize
		inst.Font = fontOf(theme.font[variant] or theme.font.body)
		inst.TextSize = fsize
		inst.TextWrapped = true
		inst.RichText = true
		inst.Text = node.text or ""
		inst.TextColor3 = col(node.color, (variant == "caption") and pcol(theme, "textMuted") or pcol(theme, "text"))
		inst.TextXAlignment = (node.align == "center" and Enum.TextXAlignment.Center)
			or (node.align == "right" and Enum.TextXAlignment.Right)
			or Enum.TextXAlignment.Left
		inst.AutomaticSize = Enum.AutomaticSize.Y
		inst.Size = UDim2.new(1, 0, 0, fsize + 4)
	elseif t == "button" then
		inst = Instance.new("TextButton")
		inst.AutoButtonColor = true
		local variant = node.variant or "primary"
		local bg, txt, strokeC
		if variant == "secondary" then
			bg, txt, strokeC = pcol(theme, "surfaceAlt"), pcol(theme, "text"), pcol(theme, "stroke")
		elseif variant == "danger" then
			bg, txt, strokeC = pcol(theme, "danger"), Color3.fromRGB(255, 255, 255), pcol(theme, "danger")
		elseif variant == "ghost" then
			bg, txt, strokeC = nil, pcol(theme, "accent"), pcol(theme, "accent")
		else
			bg, txt, strokeC = pcol(theme, "accent"), pcol(theme, "accentText"), pcol(theme, "accent")
		end
		if variant == "ghost" then
			inst.BackgroundTransparency = 1
		else
			inst.BackgroundColor3 = col(node.bg, bg)
			addGradient(inst, theme.effects.gradient, theme.effects.gradientRotation)
		end
		inst.Text = node.text or "Button"
		inst.Font = fontOf(theme.font.heading)
		inst.TextSize = node.textSize or theme.font.bodySize
		inst.TextColor3 = col(node.color, txt)
		addCorner(inst, node.cornerRadius or theme.shape.corner)
		addStroke(inst, col(node.strokeColor, strokeC), node.strokeThickness or theme.shape.stroke, theme.shape.strokeTransparency)
		addPadding(inst, math.floor((node.padding or theme.shape.padding) * 0.5))
		inst.Size = UDim2.new(1, 0, 0, 40)
	elseif t == "bar" then
		inst = Instance.new("Frame")
		inst.BackgroundColor3 = col(node.bg, pcol(theme, "surfaceAlt"))
		inst.ClipsDescendants = true
		addCorner(inst, node.cornerRadius or theme.shape.corner)
		addStroke(inst, pcol(theme, "stroke"), theme.shape.stroke, theme.shape.strokeTransparency)
		inst.Size = UDim2.new(1, 0, 0, 20)
		local v = math.clamp(node.value or 0, 0, 1)
		local fillF = Instance.new("Frame")
		fillF.Name = "Fill"
		fillF.BorderSizePixel = 0
		fillF.BackgroundColor3 = col(node.color, pcol(theme, "accent"))
		fillF.Size = UDim2.new(v, 0, 1, 0)
		addCorner(fillF, node.cornerRadius or theme.shape.corner)
		addGradient(fillF, theme.effects.gradient, theme.effects.gradientRotation)
		fillF.Parent = inst
		if node.label or node.showValue then
			local lab = Instance.new("TextLabel")
			lab.BackgroundTransparency = 1
			lab.Size = UDim2.new(1, 0, 1, 0)
			lab.Font = fontOf(theme.font.caption)
			lab.TextSize = theme.font.captionSize
			lab.TextColor3 = pcol(theme, "text")
			local txt = node.label or ""
			if node.showValue then
				txt = (txt ~= "" and (txt .. "  ") or "") .. tostring(math.floor(v * 100)) .. "%"
			end
			lab.Text = txt
			lab.ZIndex = 2
			lab.Parent = inst
		end
	elseif t == "icon" then
		inst = Instance.new(node.button and "ImageButton" or "ImageLabel")
		if node.bg then
			inst.BackgroundColor3 = col(node.bg, pcol(theme, "surface"))
			addCorner(inst, node.cornerRadius or theme.shape.corner)
		else
			inst.BackgroundTransparency = 1
		end
		local img = tostring(node.image or "")
		if string.match(img, "^%d+$") then
			img = "rbxassetid://" .. img
		end
		inst.Image = img
		inst.Size = UDim2.new(0, 48, 0, 48)
	elseif t == "input" then
		inst = Instance.new("TextBox")
		inst.BackgroundColor3 = col(node.bg, pcol(theme, "surfaceAlt"))
		inst.Text = node.text or ""
		inst.PlaceholderText = node.placeholder or ""
		inst.PlaceholderColor3 = pcol(theme, "textMuted")
		inst.Font = fontOf(theme.font.body)
		inst.TextSize = node.textSize or theme.font.bodySize
		inst.TextColor3 = col(node.color, pcol(theme, "text"))
		inst.TextXAlignment = Enum.TextXAlignment.Left
		inst.ClearTextOnFocus = false
		addCorner(inst, node.cornerRadius or theme.shape.corner)
		addStroke(inst, col(node.strokeColor, pcol(theme, "stroke")), node.strokeThickness or theme.shape.stroke, theme.shape.strokeTransparency)
		addPadding(inst, math.floor((node.padding or theme.shape.padding) * 0.6))
		inst.Size = UDim2.new(1, 0, 0, 40)
	elseif t == "divider" then
		inst = Instance.new("Frame")
		inst.BackgroundColor3 = col(node.color, pcol(theme, "stroke"))
		inst.BackgroundTransparency = node.transparency or 0.3
		inst.BorderSizePixel = 0
		inst.Size = UDim2.new(1, 0, 0, node.strokeThickness or 1)
	elseif t == "spacer" then
		inst = Instance.new("Frame")
		inst.BackgroundTransparency = 1
		inst.Size = UDim2.new(1, 0, 0, node.gap or theme.shape.gap)
	else
		-- container: panel / list / grid
		inst = Instance.new("Frame")
		if t == "list" then
			if node.bg then
				inst.BackgroundColor3 = col(node.bg, pcol(theme, "surface"))
			else
				inst.BackgroundTransparency = 1
			end
		else
			inst.BackgroundColor3 = col(node.bg, pcol(theme, "surface"))
			addCorner(inst, node.cornerRadius or theme.shape.corner)
			addStroke(inst, col(node.strokeColor, pcol(theme, "stroke")), node.strokeThickness or theme.shape.stroke, theme.shape.strokeTransparency)
			addGradient(inst, theme.effects.gradient, theme.effects.gradientRotation)
		end
		addPadding(inst, node.padding or theme.shape.padding)
		inst.Size = UDim2.new(0, 300, 0, 200)
		if t == "grid" then
			local cell = UDim2.fromOffset(100, 100)
			local cw, ch = xy(node.cellSize)
			if cw then
				cell = UDim2.fromOffset(cw, ch)
			end
			local g = Instance.new("UIGridLayout")
			g.CellSize = cell
			g.CellPadding = UDim2.fromOffset(node.gap or theme.shape.gap, node.gap or theme.shape.gap)
			g.SortOrder = Enum.SortOrder.LayoutOrder
			g.Parent = inst
			if node.children then
				local order = 0
				for _, child in ipairs(node.children) do
					local ci = buildNode(child, theme, "grid")
					if ci then
						order += 1
						ci.LayoutOrder = order
						ci.Parent = inst
					end
				end
			end
		else
			applyChildren(inst, node, theme)
		end
	end

	-- common props
	inst.Name = node.name or (t:sub(1, 1):upper() .. t:sub(2))
	if inst:IsA("GuiObject") then
		inst.BorderSizePixel = 0
	end
	if node.transparency ~= nil and t ~= "divider" and t ~= "label" then
		inst.BackgroundTransparency = node.transparency
	end
	local sz, autoX, autoY = parseSize(node.size)
	if sz then
		inst.Size = sz
		inst.AutomaticSize = Enum.AutomaticSize.None
	end
	if autoX or autoY then
		inst.AutomaticSize = (autoX and autoY and Enum.AutomaticSize.XY)
			or (autoX and Enum.AutomaticSize.X)
			or Enum.AutomaticSize.Y
	end
	if node.zindex then
		inst.ZIndex = node.zindex
	end
	if node.visible == false then
		inst.Visible = false
	end
	-- vertical layout: default cross-axis width to fill unless sized explicitly
	if layoutDir == "vertical" and not node.size then
		inst.Size = UDim2.new(1, 0, inst.Size.Y.Scale, inst.Size.Y.Offset)
	end
	applyPlacement(inst, node, inLayout)
	return inst
end

-- ---------- command handlers -------------------------------------------------
local VIEW_DIRS = {
	front = Vector3.new(0, 0.15, 1),
	back = Vector3.new(0, 0.15, -1),
	left = Vector3.new(-1, 0.15, 0),
	right = Vector3.new(1, 0.15, 0),
	iso = Vector3.new(1, 0.8, 1),
	top = Vector3.new(0, 1, 0),
}

local cutStore = {}
local cutSeq = 0

local handlers = {}

function handlers.ping()
	return { pong = true, place = game.Name }
end

-- Snapshot the user's camera so captures can leave it exactly as they found it.
-- Setting cam.CFrame from a plugin forces CameraType=Scriptable; without this the
-- camera stays frozen after a capture. Returns the viewport pixel size too, which
-- the Node side uses to crop Studio chrome (Explorer/Output) out of the screenshot.
function handlers.save_camera()
	local cam = workspace.CurrentCamera
	local c = cam.CFrame
	local f = cam.Focus
	local vp = cam.ViewportSize
	return {
		cframe = { c:GetComponents() },
		focus = { f:GetComponents() },
		cameraType = cam.CameraType.Name,
		viewport = { vp.X, vp.Y },
	}
end

function handlers.restore_camera(args)
	local cam = workspace.CurrentCamera
	if args.cframe and #args.cframe == 12 then
		cam.CFrame = CFrame.new(table.unpack(args.cframe))
	end
	if args.focus and #args.focus == 12 then
		cam.Focus = CFrame.new(table.unpack(args.focus))
	end
	if args.cameraType then
		local ok, ct = pcall(function()
			return Enum.CameraType[args.cameraType]
		end)
		if ok and ct then
			cam.CameraType = ct
		end
	end
	return { ok = true }
end

-- Fit math shared by frame (moves the camera) and frame_coords (returns only).
local function computeFrame(target, view, zoom)
	local center, size = getBBox(target)
	local cam = workspace.CurrentCamera
	view = view or "iso"
	local dir = (VIEW_DIRS[view] or VIEW_DIRS.iso).Unit
	local fov = cam.FieldOfView
	local radius = size.Magnitude / 2
	local dist = (radius / math.tan(math.rad(fov) / 2)) * (zoom or 1.1)
	local camPos = center + dir * dist
	return center, size, camPos, fov, view
end

function handlers.frame(args)
	local center, size, camPos, _, view = computeFrame(args.target, args.view, args.zoom)
	local cam = workspace.CurrentCamera
	if view == "top" then
		cam.CFrame = CFrame.lookAt(camPos, center, Vector3.new(0, 0, -1))
	else
		cam.CFrame = CFrame.lookAt(camPos, center)
	end
	cam.Focus = CFrame.new(center)
	return {
		pos = { camPos.X, camPos.Y, camPos.Z },
		look = { center.X, center.Y, center.Z },
		size = { size.X, size.Y, size.Z },
	}
end

-- Same fit math but DOESN'T move the camera — returns coords to feed the official
-- screen_capture tool (clean, no Studio chrome, no foreground requirement).
function handlers.frame_coords(args)
	local center, size, camPos, fov, view = computeFrame(args.target, args.view, args.zoom)
	return {
		camera_position = { camPos.X, camPos.Y, camPos.Z },
		look_at_position = { center.X, center.Y, center.Z },
		field_of_view = fov,
		size = { size.X, size.Y, size.Z },
		view = view,
	}
end

-- Frame from an arbitrary azimuth/elevation (degrees) for orbit/turntable shots.
-- az=0 looks down +Z (front), az=90 looks down +X (right); el lifts above horizon.
function handlers.frame_dir(args)
	local center, size = getBBox(args.target)
	local cam = workspace.CurrentCamera
	local az = math.rad(args.azimuth or 0)
	local el = math.rad(args.elevation or 20)
	local dir = Vector3.new(math.cos(el) * math.sin(az), math.sin(el), math.cos(el) * math.cos(az))
	if dir.Magnitude < 1e-4 then
		dir = Vector3.new(0, 1, 0)
	end
	dir = dir.Unit
	local fov = cam.FieldOfView
	local radius = size.Magnitude / 2
	local dist = (radius / math.tan(math.rad(fov) / 2)) * (args.zoom or 1.15)
	local camPos = center + dir * dist
	-- near-vertical views need a non-Y up vector or lookAt gimbal-flips
	if math.abs(dir.Y) > 0.98 then
		cam.CFrame = CFrame.lookAt(camPos, center, Vector3.new(0, 0, -1))
	else
		cam.CFrame = CFrame.lookAt(camPos, center)
	end
	cam.Focus = CFrame.new(center)
	return {
		pos = { camPos.X, camPos.Y, camPos.Z },
		look = { center.X, center.Y, center.Z },
		size = { size.X, size.Y, size.Z },
	}
end

-- Same arbitrary az/el fit math but DOESN'T move the camera — returns coords to feed
-- the official screen_capture (clean, works even when Studio is backgrounded). Lets the
-- agent do a turntable through the official tool: loop azimuths, capture each.
function handlers.frame_dir_coords(args)
	local center, size = getBBox(args.target)
	local cam = workspace.CurrentCamera
	local az = math.rad(args.azimuth or 0)
	local el = math.rad(args.elevation or 20)
	local dir = Vector3.new(math.cos(el) * math.sin(az), math.sin(el), math.cos(el) * math.cos(az))
	if dir.Magnitude < 1e-4 then
		dir = Vector3.new(0, 1, 0)
	end
	dir = dir.Unit
	local fov = cam.FieldOfView
	local dist = (size.Magnitude / 2 / math.tan(math.rad(fov) / 2)) * (args.zoom or 1.15)
	local camPos = center + dir * dist
	return {
		camera_position = { camPos.X, camPos.Y, camPos.Z },
		look_at_position = { center.X, center.Y, center.Z },
		field_of_view = fov,
		size = { size.X, size.Y, size.Z },
		azimuth = args.azimuth or 0,
		elevation = args.elevation or 20,
	}
end

-- Edit an existing target in place (so build -> see -> fix needs no raw Luau).
function handlers.edit(args)
	local inst = findInst(args.target)
	if not inst then
		error("target not found: " .. tostring(args.target))
	end
	local op = args.op
	local bC, bS
	if inst:IsA("Model") or inst:IsA("BasePart") then
		bC, bS = bboxOf(inst)
	end
	return recorded("BuildKit edit " .. tostring(op), function()
		if op == "delete" then
			local n = inst.Name
			inst.Parent = nil -- ponytail: Parent=nil not Destroy() so undo can restore it
			return { op = op, deleted = n }
		elseif op == "rename" then
			if not args.name then error("rename needs name") end
			inst.Name = args.name
			return { op = op, name = inst.Name }
		elseif op == "clone" then
			local c = inst:Clone()
			c.Parent = inst.Parent
			if args.name then c.Name = args.name end
			if args.offset and #args.offset == 3 then
				pivotWorld(c, CFrame.new(args.offset[1], args.offset[2], args.offset[3]))
			end
			local center, size = bboxOf(c)
			return { op = op, name = c.Name, center = { center.X, center.Y, center.Z }, size = { size.X, size.Y, size.Z } }
		elseif op == "move" then
			local center = bboxOf(inst)
			local delta
			if args.to and #args.to == 3 then
				delta = Vector3.new(args.to[1], args.to[2], args.to[3]) - center
			elseif args.delta and #args.delta == 3 then
				delta = Vector3.new(args.delta[1], args.delta[2], args.delta[3])
			else
				error("move needs delta or to ([x,y,z])")
			end
			pivotWorld(inst, CFrame.new(delta))
		elseif op == "rotate" then
			if not (args.degrees and #args.degrees == 3) then error("rotate needs degrees [x,y,z]") end
			local center = bboxOf(inst)
			local r = CFrame.Angles(math.rad(args.degrees[1]), math.rad(args.degrees[2]), math.rad(args.degrees[3]))
			pivotWorld(inst, CFrame.new(center) * r * CFrame.new(-center))
		elseif op == "scale" then
			local s = args.scale
			if inst:IsA("Model") then
				if type(s) ~= "number" then error("model scale needs a single number factor") end
				inst:ScaleTo(inst:GetScale() * s)
			elseif inst:IsA("BasePart") then
				if type(s) == "number" then
					inst.Size = inst.Size * s
				elseif type(s) == "table" and #s == 3 then
					inst.Size = Vector3.new(inst.Size.X * s[1], inst.Size.Y * s[2], inst.Size.Z * s[3])
				else
					error("scale needs a number or [x,y,z]")
				end
			else
				error("scale target must be a Model or BasePart")
			end
		elseif op == "recolor" then
			local c = colorOf(args.color, nil)
			if not c then error("recolor needs color [r,g,b]") end
			for _, p in ipairs(partsOf(inst)) do p.Color = c end
		elseif op == "material" then
			local m = matOf(args.material, nil)
			if not m then error("material not found: " .. tostring(args.material)) end
			for _, p in ipairs(partsOf(inst)) do p.Material = m end
			elseif op == "anchor" then
				local v = args.anchored
				if v == nil then v = true end
				for _, p in ipairs(partsOf(inst)) do p.Anchored = v end
		else
			error("unknown edit op: " .. tostring(op))
		end
		local center, size = bboxOf(inst)
		local res = {
				op = op,
				name = inst.Name,
				center = { r1(center.X), r1(center.Y), r1(center.Z) },
				size = { r1(size.X), r1(size.Y), r1(size.Z) },
			}
			if bC then
				local d = center - bC
				res.movedBy = { r1(d.X), r1(d.Y), r1(d.Z) }
				res.sizeDelta = { r1(size.X - bS.X), r1(size.Y - bS.Y), r1(size.Z - bS.Z) }
			end
			return res
	end)
end

-- ROTATION-AWARE geometry helpers (the old QA used raw Size+Position = axis-aligned, so any
-- rotated primitive — every rot-90 cylinder — was mis-judged: phantom overlaps/z-fights AND
-- missed real floats). worldAABB projects the part's true oriented box onto world axes; for the
-- dominant case (90° rotations) it is EXACT, for oblique angles a tight over-approx that we then
-- gate against real geometry via GetPartsInPart.
local function worldAABB(p)
	local cf, s = p.CFrame, p.Size
	local hx, hy, hz = s.X / 2, s.Y / 2, s.Z / 2
	local rv, uv, lv = cf.RightVector, cf.UpVector, cf.LookVector
	local ex = math.abs(rv.X) * hx + math.abs(uv.X) * hy + math.abs(lv.X) * hz
	local ey = math.abs(rv.Y) * hx + math.abs(uv.Y) * hy + math.abs(lv.Y) * hz
	local ez = math.abs(rv.Z) * hx + math.abs(uv.Z) * hy + math.abs(lv.Z) * hz
	return p.Position, Vector3.new(ex, ey, ez) -- center, HALF-extents (world-aligned)
end

-- Real geometry overlap set (rotation-correct): set[a][b]=true iff a and b actually intersect.
-- Gates the AABB magnitude math so oblique parts can't raise phantom overlap/z-fight flags, and
-- gives connectivity that rewards real seating instead of bounding-box kisses.
local function realOverlaps(parts)
	local set, idx = {}, {}
	for i, p in ipairs(parts) do idx[p] = i; set[p] = {} end
	local op = OverlapParams.new()
	op.FilterType = Enum.RaycastFilterType.Include
	op.FilterDescendantsInstances = parts
	op.MaxParts = 0
	op.RespectCanCollide = false
	for _, a in ipairs(parts) do
		local ok, hits = pcall(function() return workspace:GetPartsInPart(a, op) end)
		if ok and hits then
			for _, b in ipairs(hits) do
				if b ~= a and idx[b] then set[a][b] = true; set[b][a] = true end
			end
		end
	end
	return set
end

-- Translation that seats a FLOATING part F into its nearest neighbour N (~0.12 stud overlap),
-- moving only along axes that are actually gapped so a part already seated on 2 axes just slides
-- in on the third. Used by the fix pass to auto-close true gaps (single-part orphans only).
local function seatMove(F, N)
	local fc, fh = worldAABB(F)
	local nc, nh = worldAABB(N)
	local function axm(fcv, fhv, ncv, nhv)
		local gap = math.abs(fcv - ncv) - (fhv + nhv)
		if gap <= -0.1 then return 0 end -- already overlapping enough on this axis
		local dir = (ncv >= fcv) and 1 or -1
		return dir * (gap + 0.12)
	end
	return Vector3.new(axm(fc.X, fh.X, nc.X, nh.X), axm(fc.Y, fh.Y, nc.Y, nh.Y), axm(fc.Z, fh.Z, nc.Z, nh.Z))
end

-- Geometric lint you can't eyeball: unanchored parts, double-placed duplicates,
-- deep interpenetrations (z-fight/clipping risk), part-budget warnings.
-- Within each LEAF Model (holds BaseParts but no sub-Models — a single built assembly
-- like a drawer or door), verify all its parts form ONE connected blob (REAL geometry
-- overlap, rotation-correct). A split means a piece isn't joined to the rest — a drawer
-- front off its tray, a handle floating off its panel. Scoped per-leaf-model so a drawer's
-- sliding clearance to the CARCASS (a different model) is never mistaken for a defect.
-- ov = realOverlaps set over the whole instance; seats (optional) collects {part,move} to auto-seat.
local function assemblyGaps(root, out, ov, seats)
	local function isLeaf(m)
		if not m:IsA("Model") then return false end
		local hasPart = false
		for _, d in ipairs(m:GetDescendants()) do
			if d:IsA("Model") then return false
			elseif d:IsA("BasePart") then hasPart = true end
		end
		return hasPart
	end
	local leaves = {}
	if isLeaf(root) then table.insert(leaves, root) end
	for _, d in ipairs(root:GetDescendants()) do
		if isLeaf(d) then table.insert(leaves, d) end
	end
	for _, m in ipairs(leaves) do
		local ps = {}
		for _, d in ipairs(m:GetDescendants()) do
			if d:IsA("BasePart") then table.insert(ps, d) end
		end
		local k = #ps
		if k >= 2 and k <= 400 then
			local par = {}
			for i = 1, k do par[i] = i end
			local function find(x)
				while par[x] ~= x do
					par[x] = par[par[x]]
					x = par[x]
				end
				return x
			end
			local AB = {} -- rotation-aware world AABB per part (computed once)
			for i = 1, k do
				local c, h = worldAABB(ps[i])
				AB[i] = { c = c, h = h }
			end
			-- adjacency = REAL geometry overlap (rotation-correct) OR a flush/near-touch within a small
			-- rotation-aware tolerance, so clean butt joints and tight multi-segment chains (frond
			-- arcs, candelabra arms) aren't mistaken for floating pieces. EPS is kept small (0.1) so an
			-- oblique part's empty AABB corner still reads as a real gap.
			local EPS = 0.1
			local function near(ia, ib)
				local A, B = AB[ia], AB[ib]
				return math.abs(A.c.X - B.c.X) <= A.h.X + B.h.X + EPS
					and math.abs(A.c.Y - B.c.Y) <= A.h.Y + B.h.Y + EPS
					and math.abs(A.c.Z - B.c.Z) <= A.h.Z + B.h.Z + EPS
			end
			for i = 1, k do
				for j = i + 1, k do
					if (ov[ps[i]] and ov[ps[i]][ps[j]]) or near(i, j) then
						par[find(i)] = find(j)
					end
				end
			end
			local comp = {}
			for i = 1, k do
				local r = find(i)
				comp[r] = comp[r] or {}
				table.insert(comp[r], i)
			end
			local ncomp, mainRoot, mainSize = 0, nil, nil
			for r, members in pairs(comp) do
				ncomp += 1
				if not mainSize or #members > mainSize then mainSize = #members; mainRoot = r end
			end
			if ncomp > 1 then
				local best
				for i = 1, k do
					for j = i + 1, k do
						if find(i) ~= find(j) then
							local A, B = AB[i], AB[j]
							local dx = math.max(0, math.abs(A.c.X - B.c.X) - (A.h.X + B.h.X))
							local dy = math.max(0, math.abs(A.c.Y - B.c.Y) - (A.h.Y + B.h.Y))
							local dz = math.max(0, math.abs(A.c.Z - B.c.Z) - (A.h.Z + B.h.Z))
							local d = math.sqrt(dx * dx + dy * dy + dz * dz)
							if not best or d < best then best = d end
						end
					end
				end
				if #out < 25 then
					table.insert(out, string.format("%s splits into %d unjoined groups (nearest gap %.2f)", m:GetFullName(), ncomp, best or 0))
				end
				-- auto-seat (fix pass): a lone floating piece (single-part orphan component) is nudged
				-- into the nearest part of the main blob. Multi-part orphans are only reported — moving a
				-- sub-cluster could distort it, and seating a part with >1 joint could tear the other.
				if seats then
					-- Only auto-seat ISOLATED breaks: count lone (single-part) orphans first. A detailed
					-- prop with MANY spread pieces (plant fronds, decorative greebles) is not one broken
					-- part — mass-seating would collapse it inward. >2 lone orphans => report only.
					local lone = 0
					for r, members in pairs(comp) do
						if r ~= mainRoot and #members == 1 then lone += 1 end
					end
					if lone <= 2 then
						for r, members in pairs(comp) do
							if r ~= mainRoot and #members == 1 then
								local F = ps[members[1]]
								local fc = AB[members[1]].c
								local nearest, nd
								for _, mi in ipairs(comp[mainRoot]) do
									local d = (fc - AB[mi].c).Magnitude
									if not nd or d < nd then nd = d; nearest = ps[mi] end
								end
								-- near-miss only: a large move means the part is meant to sit apart, not seat
								local mv = nearest and seatMove(F, nearest)
								if mv and mv.Magnitude <= 0.6 then table.insert(seats, { part = F, move = mv }) end
							end
						end
					end
				end
			end
		end
	end
end

-- Core QA scan over an instance (shared by handlers.qa and the build handler's auto-QA).
qaScan = function(inst, doFix)
	local args = { fix = doFix }
	local parts = partsOf(inst)
	local n = #parts
	local unanchored = {}
	for _, p in ipairs(parts) do
		if not p.Anchored then
			if #unanchored < 25 then
				table.insert(unanchored, p:GetFullName())
			end
		end
	end
	local unanchoredCount = 0
	for _, p in ipairs(parts) do
		if not p.Anchored then unanchoredCount += 1 end
	end
	local CAP = 1200
	local duplicates, deepOverlaps, nearGaps, zFights, fitGaps = {}, {}, {}, {}, {}
	local zfFix = {} -- {part, axis, dir} pairs to nudge apart when args.fix
	local seats = {} -- {part, move} floating pieces to auto-seat when args.fix
	local ov = {}
	-- fit-gap (args.fit): a piece that should sit flush against a DIFFERENT assembly but leaves a
	-- visible slot (a leg short of the floor, a panel not meeting its frame, a drawer front not
	-- filling its opening). assemblyId groups by nearest Model so within-model disconnects (which
	-- assemblyGaps already catches) aren't double-counted; slidingModel spots an INTENDED drawer/door
	-- slide clearance so it isn't flagged as a defect.
	local function assemblyId(p)
		local a = p.Parent
		while a and a ~= workspace do if a:IsA("Model") then return a end; a = a.Parent end
		return p
	end
	local function slidingModel(p)
		local a = p.Parent
		while a and a ~= workspace do
			if a:IsA("Model") then local k = a:GetAttribute("Kind"); if k == "drawer" or k == "door" then return a end end
			a = a.Parent
		end
		return nil
	end
	if n <= CAP then
		ov = realOverlaps(parts) -- rotation-correct real-overlap set; gates the AABB magnitude math
		local AB = {}
		for i = 1, n do
			local c, h = worldAABB(parts[i])
			AB[i] = { c = c, h = h, vol = 8 * h.X * h.Y * h.Z }
		end
		for i = 1, n do
			local a = parts[i]
			local A = AB[i]
			for j = i + 1, n do
				local b = parts[j]
				local B = AB[j]
				if args.fit and assemblyId(a) ~= assemblyId(b) then
						local sa, sb = slidingModel(a), slidingModel(b)
						local intended = (sa and not b:IsDescendantOf(sa)) or (sb and not a:IsDescendantOf(sb))
						if not intended then
							local gx = math.min(A.c.X + A.h.X, B.c.X + B.h.X) - math.max(A.c.X - A.h.X, B.c.X - B.h.X)
							local gy = math.min(A.c.Y + A.h.Y, B.c.Y + B.h.Y) - math.max(A.c.Y - A.h.Y, B.c.Y - B.h.Y)
							local gz = math.min(A.c.Z + A.h.Z, B.c.Z + B.h.Z) - math.max(A.c.Z - A.h.Z, B.c.Z - B.h.Z)
							local GMIN, GMAX, FACE = 0.03, 0.6, 0.5
							local axis, g
							if gx < -GMIN and gx >= -GMAX and gy > FACE and gz > FACE then axis, g = "X", -gx
							elseif gy < -GMIN and gy >= -GMAX and gx > FACE and gz > FACE then axis, g = "Y", -gy
							elseif gz < -GMIN and gz >= -GMAX and gx > FACE and gy > FACE then axis, g = "Z", -gz end
							if axis and #fitGaps < 25 then
								table.insert(fitGaps, string.format("%s | %s — %.2f gap on %s (faces nearly meet but don't touch; butt them or close the gap)", a:GetFullName(), b:GetFullName(), g, axis))
							end
						end
					end
					if (a.Position - b.Position).Magnitude < 0.05 and (a.Size - b.Size).Magnitude < 0.05 then
					if #duplicates < 25 then
						table.insert(duplicates, a:GetFullName() .. " == " .. b:GetFullName())
					end
				elseif ov[a] and ov[a][b] then
					-- only pairs whose REAL geometry intersects (no phantom overlaps from oblique
					-- parts). Magnitudes come from rotation-aware world AABBs.
					local ox = math.min(A.c.X + A.h.X, B.c.X + B.h.X) - math.max(A.c.X - A.h.X, B.c.X - B.h.X)
					local oy = math.min(A.c.Y + A.h.Y, B.c.Y + B.h.Y) - math.max(A.c.Y - A.h.Y, B.c.Y - B.h.Y)
					local oz = math.min(A.c.Z + A.h.Z, B.c.Z + B.h.Z) - math.max(A.c.Z - A.h.Z, B.c.Z - B.h.Z)
					if ox > 0 and oy > 0 and oz > 0 then
						local ovol = ox * oy * oz
						local minvol = math.min(A.vol, B.vol)
						if minvol > 0 and ovol > 0.25 * minvol then
							if #deepOverlaps < 25 then
								table.insert(deepOverlaps, string.format("%s overlaps %s (%d%%)", a:GetFullName(), b:GetFullName(), math.floor(100 * ovol / minvol)))
							end
						end
						-- z-fight: a SAME-direction face pair is coincident (within eps) while the
						-- parts overlap for real on the other two axes — two surfaces at the same
						-- plane fight over depth and FLICKER. (Opposite-direction coincidence = a
						-- clean butt joint, not flagged.)
						local EPS = 0.05
						local zf
						if (math.abs((A.c.X + A.h.X) - (B.c.X + B.h.X)) < EPS or math.abs((A.c.X - A.h.X) - (B.c.X - B.h.X)) < EPS) and oy > 0.15 and oz > 0.15 then
							zf = "X"
						elseif (math.abs((A.c.Y + A.h.Y) - (B.c.Y + B.h.Y)) < EPS or math.abs((A.c.Y - A.h.Y) - (B.c.Y - B.h.Y)) < EPS) and ox > 0.15 and oz > 0.15 then
							zf = "Y"
						elseif (math.abs((A.c.Z + A.h.Z) - (B.c.Z + B.h.Z)) < EPS or math.abs((A.c.Z - A.h.Z) - (B.c.Z - B.h.Z)) < EPS) and ox > 0.15 and oy > 0.15 then
							zf = "Z"
						end
						if zf then
							if #zFights < 25 then
								table.insert(zFights, string.format("%s vs %s — coplanar faces on %s (z-fight/flicker; inset ~0.05 or separate)", a:GetFullName(), b:GetFullName(), zf))
							end
							if args.fix then
								local function plane(h)
									if zf == "X" then return (2 * h.Y) * (2 * h.Z)
									elseif zf == "Y" then return (2 * h.X) * (2 * h.Z)
									else return (2 * h.X) * (2 * h.Y) end
								end
								local pa, pb = plane(A.h), plane(B.h)
								local ratio = (math.max(pa, pb) > 0) and (math.min(pa, pb) / math.max(pa, pb)) or 1
								-- skip a small detail flush on a big surface (fuller/label/trim): nudging it protrudes
								if ratio >= 0.5 then
									local mover = (pb <= pa) and b or a
									local oh = (mover == b) and A or B
									local mc = (zf == "X" and mover.Position.X) or (zf == "Y" and mover.Position.Y) or mover.Position.Z
									local oc = (zf == "X" and oh.c.X) or (zf == "Y" and oh.c.Y) or oh.c.Z
									table.insert(zfFix, { p = mover, axis = zf, dir = (mc >= oc) and 1 or -1 })
								end
							end
						end
					end
				end
			end
		end
	end
	-- disconnected pieces inside each built assembly (drawer front off its tray, handle off panel)
	assemblyGaps(inst, nearGaps, ov, args.fix and seats or nil)
	-- fix=true: nudge each z-fighting part 0.06 off the shared plane (one undo step). Capped: a model
	-- with MANY coplanar pairs is densely detailed (leaf planks, greebles) where mass-nudging does more
	-- harm than the flicker — report those instead of shoving 20+ parts around.
	local zFixed = 0
	if args.fix and #zfFix > 0 and #zfFix <= 12 then
		recorded("BuildKit qa fix z-fights", function()
			local done = {}
			for _, f in ipairs(zfFix) do
				if f.p and f.p.Parent and not done[f.p] then
					done[f.p] = true
					local off = 0.06 * f.dir
					f.p.CFrame = f.p.CFrame + Vector3.new(f.axis == "X" and off or 0, f.axis == "Y" and off or 0, f.axis == "Z" and off or 0)
					zFixed += 1
				end
			end
		end)
	end
	-- fix=true: auto-seat lone floating pieces into the main blob (one undo step).
	local seated = 0
	if args.fix and #seats > 0 then
		recorded("BuildKit qa seat floating parts", function()
			for _, s in ipairs(seats) do
				if s.part and s.part.Parent and s.move.Magnitude > 0.001 then
					s.part.CFrame = s.part.CFrame + s.move
					seated += 1
				end
			end
		end)
	end
	local center, size = bboxOf(inst)
	local warnings = {}
	if n > CAP then
		table.insert(warnings, string.format("overlap scan skipped: %d parts over %d cap", n, CAP))
	end
	if n > 1000 then
		table.insert(warnings, string.format("high part count: %d", n))
	end
	if unanchoredCount > 0 then
		table.insert(warnings, string.format("%d unanchored part(s)", unanchoredCount))
	end
	if #duplicates > 0 then
		table.insert(warnings, string.format("%d duplicate-placement pair(s)", #duplicates))
	end
	if #deepOverlaps > 0 then
		table.insert(warnings, string.format("%d deep-overlap pair(s)", #deepOverlaps))
	end
	if #nearGaps > 0 then
		table.insert(warnings, string.format("%d assembly(ies) with unjoined pieces (gap inside a model)", #nearGaps))
	end
	if #zFights > 0 then
		table.insert(warnings, string.format("%d coplanar/overlapping surface pair(s) — z-fight FLICKER risk", #zFights))
	end
	if #fitGaps > 0 then
		table.insert(warnings, string.format("%d fit-gap(s) — pieces from different assemblies nearly touch but leave a slot (opt-in fit check; VERIFY vs a capture — rotated parts can false-flag)", #fitGaps))
	end
	if zFixed > 0 then
		table.insert(warnings, string.format("fix: nudged %d z-fighting part(s) 0.06 apart (re-run rbx_qa to confirm)", zFixed))
	end
	if seated > 0 then
		table.insert(warnings, string.format("fix: seated %d floating part(s) into the model (re-run rbx_qa to confirm)", seated))
	end
	return {
		target = inst.Name,
		parts = n,
		bbox = { center = { center.X, center.Y, center.Z }, size = { size.X, size.Y, size.Z } },
		unanchored = { count = unanchoredCount, sample = unanchored },
		duplicates = duplicates,
		deepOverlaps = deepOverlaps,
		nearGaps = nearGaps,
		zFights = zFights,
		fitGaps = fitGaps,
		fixed = zFixed,
		seated = seated,
		warnings = warnings,
	}
end

function handlers.qa(args)
	local inst = findInst(args.target)
	if not inst then
		error("target not found: " .. tostring(args.target))
	end
	return qaScan(inst, args.fix)
end

-- insert a generated Open Cloud asset (from the local-gen pipeline) into the workspace,
-- scale it to a target largest-dimension, anchor + place it. Called by the rbx_gen_mesh tool.
function handlers.insertAsset(args)
	local assetId = tonumber(args.assetId)
	if not assetId then
		error("insertAsset: bad assetId " .. tostring(args.assetId))
	end
	local ok, res = pcall(function()
		return game:GetService("InsertService"):LoadAsset(assetId)
	end)
	if not ok then
		error("LoadAsset failed: " .. tostring(res))
	end
	res.Parent = workspace
	res.Name = args.name or ("GenAsset_" .. assetId)
	-- scale whole model to a target largest dimension (Hunyuan meshes import oversized)
	local target = tonumber(args.size) or 4
	local _, sz = res:GetBoundingBox()
	local maxd = math.max(sz.X, sz.Y, sz.Z)
	if maxd > 0 and target > 0 then
		pcall(function() res:ScaleTo(target / maxd) end)
	end
	for _, d in ipairs(res:GetDescendants()) do
		if d:IsA("BasePart") then d.Anchored = true end
	end
	local p = args.place
	if type(p) == "table" and #p == 3 then
		res:PivotTo(CFrame.new(tonumber(p[1]) or 0, tonumber(p[2]) or 0, tonumber(p[3]) or 0))
	end
	local parts = 0
	for _, d in ipairs(res:GetDescendants()) do
		if d:IsA("BasePart") then parts += 1 end
	end
	local _, fsz = res:GetBoundingBox()
	return { model = res.Name, assetId = assetId, parts = parts, size = { r1(fsz.X), r1(fsz.Y), r1(fsz.Z) } }
end

-- runtime open/close controller embedded in a split chest: a ProximityPrompt on the base
-- swings the Lid up about its back-bottom hinge edge (Play mode only — scripts don't run in Edit).
local CHEST_LID_SOURCE = [==[
local chest = script.Parent
local lid = chest:FindFirstChild("Lid")
local base = chest:FindFirstChild("Base")
if not (lid and base) then return end
local TweenService = game:GetService("TweenService")
local prompt = Instance.new("ProximityPrompt")
prompt.ActionText = "Open"; prompt.ObjectText = "Chest"; prompt.HoldDuration = 0
prompt.MaxActivationDistance = 14; prompt.RequiresLineOfSight = false; prompt.Parent = base
local closedCF = lid.CFrame
local sz = lid.Size
-- hinge edge: back-bottom; axis = the wider horizontal axis (runs along the back edge)
local hingePos, hingeRot
if sz.X >= sz.Z then
	hingePos = lid.Position + Vector3.new(0, -sz.Y / 2, -sz.Z / 2) -- back = -Z
	hingeRot = CFrame.new(hingePos) -- rotate about world X
else
	hingePos = lid.Position + Vector3.new(-sz.X / 2, -sz.Y / 2, 0) -- back = -X
	hingeRot = CFrame.new(hingePos) * CFrame.Angles(0, math.rad(90), 0) -- rotate about world Z->local X
end
local rel = hingeRot:Inverse() * closedCF
local openCF = hingeRot * CFrame.Angles(math.rad(-105), 0, 0) * rel
local isOpen = false
prompt.Triggered:Connect(function()
	isOpen = not isOpen
	prompt.ActionText = isOpen and "Close" or "Open"
	TweenService:Create(lid, TweenInfo.new(0.6, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { CFrame = isOpen and openCF or closedCF }):Play()
end)
]==]

-- insert a SPLIT generated asset (base + lid) as one openable chest. Loads both halves (which
-- share the source FBX coordinate frame), re-stacks the lid flush on the base, scales the whole
-- thing to a target size, and embeds the open/close controller. Called by rbx_gen_mesh split=true.
function handlers.insertChest(args)
	local IS = game:GetService("InsertService")
	local function loadMesh(id)
		local asset = IS:LoadAsset(tonumber(id))
		local mp
		for _, d in ipairs(asset:GetDescendants()) do
			if d:IsA("MeshPart") or d:IsA("BasePart") then mp = d; break end
		end
		return asset, mp
	end
	local baseAsset, baseMP = loadMesh(args.baseAssetId)
	local lidAsset, lidMP = loadMesh(args.lidAssetId)
	if not (baseMP and lidMP) then
		error("insertChest: a half is missing its mesh")
	end
	local chest = Instance.new("Model")
	chest.Name = args.name or "GenChest"
	chest.Parent = workspace
	baseMP.Name = "Base"; baseMP.Anchored = true; baseMP.Parent = chest
	lidMP.Name = "Lid"; lidMP.Anchored = true; lidMP.Parent = chest
	pcall(function() baseAsset:Destroy() end)
	pcall(function() lidAsset:Destroy() end)
	-- re-stack: lid bottom flush on base top, centered on the base footprint (robust to any drift)
	local bc, bs = baseMP.Position, baseMP.Size
	local _, ls = lidMP.Position, lidMP.Size
	lidMP.CFrame = CFrame.new(bc.X, bc.Y + bs.Y / 2 + ls.Y / 2, bc.Z)
	-- scale whole chest to target largest dimension
	local target = tonumber(args.size) or 4
	local _, csz = chest:GetBoundingBox()
	local maxd = math.max(csz.X, csz.Y, csz.Z)
	if maxd > 0 and target > 0 then
		pcall(function() chest:ScaleTo(target / maxd) end)
	end
	chest.PrimaryPart = baseMP
	local p = args.place
	if type(p) == "table" and #p == 3 then
		chest:PivotTo(CFrame.new(tonumber(p[1]) or 0, tonumber(p[2]) or 0, tonumber(p[3]) or 0))
	end
	local s = Instance.new("Script")
	s.Name = "ChestController"
	s.Source = CHEST_LID_SOURCE
	s.Parent = chest
	local _, fsz = chest:GetBoundingBox()
	return { model = chest.Name, base = args.baseAssetId, lid = args.lidAssetId, size = { r1(fsz.X), r1(fsz.Y), r1(fsz.Z) } }
end

-- Undo/redo Studio waypoints (each BuildKit mutation is one recorded step).
function handlers.undo(args)
	local steps = math.max(1, math.floor(tonumber(args.steps) or 1))
	local redo = args.redo == true
	local done = 0
	for _ = 1, steps do
		local ok = pcall(function()
			if redo then
				if not ChangeHistoryService:GetCanRedo() then error("nothing to redo") end
				ChangeHistoryService:Redo()
			else
				if not ChangeHistoryService:GetCanUndo() then error("nothing to undo") end
				ChangeHistoryService:Undo()
			end
		end)
		if not ok then break end
		done += 1
	end
	return { action = redo and "redo" or "undo", steps = done }
end

function handlers.cutaway(args)
	local root = findInst(args.target)
	if not root then
		error("target not found: " .. tostring(args.target))
	end
	local center, size = getBBox(args.target)
	local y = args.y
	if not y then
		y = (center.Y + size.Y / 2) - size.Y * 0.15 -- default: hide top 15%
	end
	cutSeq += 1
	local token = "cut" .. cutSeq
	-- Hide by Transparency=1, NOT reparent-to-nil: a lost restore then just leaves
	-- a part invisible (recoverable), never orphaned + garbage-collected.
	local hidden = {}
	for _, d in ipairs(root:GetDescendants()) do
		if d:IsA("BasePart") and not d:IsA("Terrain") and d.Position.Y > y then
			table.insert(hidden, { inst = d, transparency = d.Transparency })
			d.Transparency = 1
		end
	end
	cutStore[token] = hidden
	return { token = token, hiddenCount = #hidden, y = y }
end

-- Un-hide a cutaway/isolate token: restore each part's saved Transparency.
function handlers.restore(args)
	local hidden = cutStore[args.token]
	if hidden then
		for _, e in ipairs(hidden) do
			if e.inst and e.inst.Parent then
				pcall(function()
					e.inst.Transparency = e.transparency
				end)
			end
		end
		cutStore[args.token] = nil
	end
	return { restored = true }
end

function handlers.inspect(args)
	local inst = findInst(args.target)
	if not inst then
		error("target not found: " .. tostring(args.target))
	end
	local center, size = getBBox(args.target)
	local parts = 0
	for _, d in ipairs(inst:GetDescendants()) do
		if d:IsA("BasePart") then
			parts += 1
		end
	end
	if inst:IsA("BasePart") then
		parts += 1
	end
	local kids = {}
	for _, k in ipairs(inst:GetChildren()) do
		table.insert(kids, k.Name .. " (" .. k.ClassName .. ")")
	end
	return {
		name = inst.Name,
		class = inst.ClassName,
		center = { center.X, center.Y, center.Z },
		size = { size.X, size.Y, size.Z },
		parts = parts,
		children = kids,
	}
end

-- Text "eyes": compact recursive readback so most edits need no screenshot.
function handlers.describe(args)
	local inst = findInst(args.target)
	if not inst then
		error("target not found: " .. tostring(args.target))
	end
	local depth = math.clamp(math.floor(tonumber(args.depth) or 1), 0, 4)
	return describeInst(inst, depth)
end

-- Read or set the Studio selection: operate on what the user clicked ('get'),
-- or select a target so the user SEES what you mean ('set').
function handlers.selection(args)
	local Selection = game:GetService("Selection")
	if args.mode == "set" then
		local inst = findInst(args.target)
		if not inst then
			error("target not found: " .. tostring(args.target))
		end
		Selection:Set({ inst })
		return { mode = "set", selected = inst:GetFullName() }
	end
	local out = {}
	for _, s in ipairs(Selection:Get()) do
		local entry = { name = s.Name, class = s.ClassName, path = s:GetFullName() }
		if s:IsA("Model") or s:IsA("BasePart") then
			local c, sz = bboxOf(s)
			entry.center = { r1(c.X), r1(c.Y), r1(c.Z) }
			entry.size = { r1(sz.X), r1(sz.Y), r1(sz.Z) }
		end
		table.insert(out, entry)
	end
	return { mode = "get", count = #out, selection = out }
end

-- Distance + axis delta between two points. Each of a,b is a name or [x,y,z].
function handlers.measure(args)
	local function resolve(t)
		if type(t) == "table" and #t == 3 then
			return Vector3.new(t[1], t[2], t[3])
		end
		local inst = findInst(t)
		if not inst then
			error("measure target not found: " .. tostring(t))
		end
		return (bboxOf(inst))
	end
	local pa = resolve(args.a)
	local pb = resolve(args.b)
	local d = pb - pa
	return {
		a = { r1(pa.X), r1(pa.Y), r1(pa.Z) },
		b = { r1(pb.X), r1(pb.Y), r1(pb.Z) },
		delta = { r1(d.X), r1(d.Y), r1(d.Z) },
		distance = r1(d.Magnitude),
	}
end

-- find: query the scene by name/class/tag/attribute/proximity. Unlike findInst
-- (name-only, first match) this returns ALL matches so the agent can locate things
-- it didn't pre-name. Read-only.
function handlers.find(args)
	local CS = game:GetService("CollectionService")
	local root = (args.root and findInst(args.root)) or workspace
	if not root then error("find root not found: " .. tostring(args.root)) end
	local limit = math.clamp(tonumber(args.limit) or 50, 1, 500)
	local nameQ = args.name and string.lower(tostring(args.name)) or nil
	local exact = args.exact == true
	local class = args.class
	local attrK = args.attr and args.attr.key
	local attrV = args.attr and args.attr.value
	local center, radius
	if type(args.near) == "table" then
		local n = args.near
		if n.target then local ti = findInst(n.target); if ti then center = (bboxOf(ti)) end
		elseif type(n.point) == "table" and #n.point == 3 then center = Vector3.new(n.point[1], n.point[2], n.point[3]) end
		radius = tonumber(n.radius) or 50
	end
	local candidates = args.tag and CS:GetTagged(args.tag) or root:GetDescendants()
	local out = {}
	for _, inst in ipairs(candidates) do
		local ok = true
		if args.tag and root ~= workspace and inst ~= root and not inst:IsDescendantOf(root) then ok = false end
		if ok and nameQ then
			local ln = string.lower(inst.Name)
			ok = exact and (ln == nameQ) or (not exact and string.find(ln, nameQ, 1, true) ~= nil)
		end
		if ok and class then local okc, isa = pcall(function() return inst:IsA(class) end); ok = okc and isa end
		if ok and attrK ~= nil then
			local av = inst:GetAttribute(attrK)
			if attrV == nil then ok = av ~= nil else ok = (av == attrV) or (tostring(av) == tostring(attrV)) end
		end
		local pos, size
		if ok then local okp, p, s = pcall(function() return bboxOf(inst) end); if okp then pos, size = p, s end end
		if ok and center then ok = pos ~= nil and (pos - center).Magnitude <= radius end
		if ok then
			local entry = { path = inst:GetFullName(), class = inst.ClassName }
			if pos then entry.pos = { r1(pos.X), r1(pos.Y), r1(pos.Z) } end
			if size then entry.size = { r1(size.X), r1(size.Y), r1(size.Z) } end
			out[#out + 1] = entry
			if #out >= limit then break end
		end
	end
	return { count = #out, truncated = #out >= limit, results = out }
end

-- cast: raycast (LOS/ground/wall) or box/sphere overlap (clearance/containment).
-- Read-only spatial perception so the agent stops hand-writing Luau for these.
function handlers.cast(args)
	local filter = {}
	if type(args.ignore) == "table" then
		for _, nm in ipairs(args.ignore) do local i = findInst(nm); if i then filter[#filter + 1] = i end end
	end
	local mode = args.mode or "ray"
	if mode == "ray" then
		local o, d = args.origin, args.dir
		if not (type(o) == "table" and #o == 3 and type(d) == "table" and #d == 3) then error("ray needs origin[3] + dir[3]") end
		local origin = Vector3.new(o[1], o[2], o[3])
		local dir = Vector3.new(d[1], d[2], d[3])
		if args.length then dir = dir.Unit * tonumber(args.length) end
		local rp = RaycastParams.new()
		rp.FilterType = Enum.RaycastFilterType.Exclude
		rp.FilterDescendantsInstances = filter
		rp.IgnoreWater = true
		local res = workspace:Raycast(origin, dir, rp)
		if not res then return { mode = "ray", hit = false } end
		return {
			mode = "ray", hit = true,
			part = res.Instance and res.Instance:GetFullName(),
			position = { r1(res.Position.X), r1(res.Position.Y), r1(res.Position.Z) },
			normal = { r1(res.Normal.X), r1(res.Normal.Y), r1(res.Normal.Z) },
			distance = r1((res.Position - origin).Magnitude),
			material = tostring(res.Material),
		}
	else
		local c = args.center
		if not (type(c) == "table" and #c == 3) then error("box/sphere needs center[3]") end
		local center = Vector3.new(c[1], c[2], c[3])
		local op = OverlapParams.new()
		op.FilterType = Enum.RaycastFilterType.Exclude
		op.FilterDescendantsInstances = filter
		op.MaxParts = math.clamp(tonumber(args.limit) or 50, 1, 500)
		local parts
		if mode == "sphere" then
			parts = workspace:GetPartBoundsInRadius(center, tonumber(args.radius) or 10, op)
		else
			local s = args.size
			if not (type(s) == "table" and #s == 3) then error("box needs size[3]") end
			parts = workspace:GetPartBoundsInBox(CFrame.new(center), Vector3.new(s[1], s[2], s[3]), op)
		end
		local out = {}
		for _, p in ipairs(parts) do out[#out + 1] = p:GetFullName() end
		return { mode = mode, count = #out, parts = out }
	end
end

-- script: READ Luau source (sync only writes). read one / list all / grep. Read-only.
function handlers.script(args)
	local mode = args.mode or "read"
	local function lineCount(src) return select(2, src:gsub("\n", "\n")) + 1 end
	if mode == "list" then
		local root = (args.target and findInst(args.target)) or game
		if not root then error("script list root not found: " .. tostring(args.target)) end
		local out = {}
		for _, d in ipairs(root:GetDescendants()) do
			if d:IsA("LuaSourceContainer") then
				out[#out + 1] = { path = d:GetFullName(), class = d.ClassName, lines = lineCount(d.Source) }
			end
		end
		return { mode = "list", count = #out, scripts = out }
	elseif mode == "find" then
		local q = tostring(args.query or "")
		if q == "" then error("script find needs query") end
		local root = (args.target and findInst(args.target)) or game
		if not root then error("script find root not found: " .. tostring(args.target)) end
		local limit = math.clamp(tonumber(args.limit) or 100, 1, 500)
		local matches = {}
		for _, d in ipairs(root:GetDescendants()) do
			if d:IsA("LuaSourceContainer") then
				local ln = 0
				for line in (d.Source .. "\n"):gmatch("(.-)\n") do
					ln += 1
					if string.find(line, q, 1, true) then
						matches[#matches + 1] = { path = d:GetFullName(), line = ln, text = string.sub(line, 1, 200) }
						if #matches >= limit then break end
					end
				end
			end
			if #matches >= limit then break end
		end
		return { mode = "find", count = #matches, truncated = #matches >= limit, matches = matches }
	else
		local inst = findInst(args.target)
		if not inst then error("script not found: " .. tostring(args.target)) end
		if not inst:IsA("LuaSourceContainer") then error(inst:GetFullName() .. " is a " .. inst.ClassName .. ", not a script") end
		local src = inst.Source
		local total = lineCount(src)
		local fromL, toL = tonumber(args.from), tonumber(args.to)
		if fromL or toL then
			fromL = math.max(1, fromL or 1); toL = toL or total
			local lines, ln = {}, 0
			for line in (src .. "\n"):gmatch("(.-)\n") do
				ln += 1
				if ln >= fromL and ln <= toL then lines[#lines + 1] = line end
				if ln > toL then break end
			end
			return { mode = "read", path = inst:GetFullName(), totalLines = total, from = fromL, to = math.min(toL, total), source = table.concat(lines, "\n") }
		end
		if total > 1500 then
			return { mode = "read", path = inst:GetFullName(), totalLines = total, error = "source has " .. total .. " lines; pass from/to to page it" }
		end
		return { mode = "read", path = inst:GetFullName(), totalLines = total, source = src }
	end
end

-- prop: get/set/list ANY property (not just Attributes, which handlers.attr covers). One undo step.
function handlers.prop(args)
	local inst = findInst(args.target)
	if not inst then error("prop target not found: " .. tostring(args.target)) end
	local mode = args.mode or "get"
	local function toValue(key, v)
		if type(v) == "table" and #v == 3 then
			local lk = string.lower(key)
			if lk:find("color") or lk:find("colour") then return Color3.new(v[1], v[2], v[3]) end
			return Vector3.new(v[1], v[2], v[3])
		end
		return v
	end
	local function fromValue(v)
		local t = typeof(v)
		if t == "Vector3" then return { r1(v.X), r1(v.Y), r1(v.Z) }
		elseif t == "Color3" then return { r1(v.R), r1(v.G), r1(v.B) }
		elseif t == "EnumItem" then return tostring(v)
		elseif t == "Instance" then return v:GetFullName()
		elseif t == "CFrame" then local p = v.Position; return { pos = { r1(p.X), r1(p.Y), r1(p.Z) } }
		else return v end
	end
	if mode == "set" then
		if not args.name then error("prop set needs name") end
		local ok, err = pcall(function()
			recorded("BuildKit prop set " .. tostring(args.name), function()
				local cur = inst[args.name]
				if typeof(cur) == "EnumItem" and type(args.value) == "string" then
					inst[args.name] = cur.EnumType[args.value]
				else
					inst[args.name] = toValue(args.name, args.value)
				end
			end)
		end)
		if not ok then error("set " .. tostring(args.name) .. " failed: " .. tostring(err)) end
		return { mode = "set", path = inst:GetFullName(), name = args.name, value = fromValue(inst[args.name]) }
	elseif mode == "list" then
		local names = args.names or { "Name", "ClassName", "Anchored", "CanCollide", "CanQuery", "CanTouch", "Transparency", "Reflectance", "Material", "Color", "Size", "CastShadow", "Massless", "Locked" }
		local out = {}
		for _, k in ipairs(names) do local ok, v = pcall(function() return inst[k] end); if ok then out[k] = fromValue(v) end end
		return { mode = "list", path = inst:GetFullName(), props = out }
	else
		if not args.name then error("prop get needs name") end
		local ok, v = pcall(function() return inst[args.name] end)
		if not ok then error("no property '" .. tostring(args.name) .. "' on " .. inst.ClassName) end
		return { mode = "get", path = inst:GetFullName(), name = args.name, value = fromValue(v), type = typeof(v) }
	end
end

-- group: wrap parts into a Model (with PrimaryPart) so a logical unit (e.g. one drawer) is one
-- grouped object; also ungroup and weld-into-a-rigid-assembly. One undo step each. The parametric
-- builders already group their sub-units (a drawer/door is its own Kind-tagged Model); this is for
-- hand-built or ungrouped geometry, or to regroup after edits.
function handlers.group(args)
	local mode = args.mode or "group"
	if mode == "group" then
		local items = {}
		if type(args.parts) == "table" then
			for _, nm in ipairs(args.parts) do local i = findInst(nm); if i then items[#items + 1] = i end end
		else
			for _, i in ipairs(game:GetService("Selection"):Get()) do items[#items + 1] = i end
		end
		if #items == 0 then error("group: no parts (pass `parts` names or select instances in Studio)") end
		local parent = items[1].Parent
		local result
		recorded("BuildKit group", function()
			local m = Instance.new("Model")
			m.Name = args.name or "Group"
			m.Parent = parent
			for _, i in ipairs(items) do i.Parent = m end
			local pp
			if args.primary then pp = m:FindFirstChild(args.primary, true) end
			if not (pp and pp:IsA("BasePart")) then
				for _, d in ipairs(m:GetDescendants()) do if d:IsA("BasePart") then pp = d; break end end
			end
			if pp and pp:IsA("BasePart") then m.PrimaryPart = pp end
			if args.kind then m:SetAttribute("Kind", tostring(args.kind)) end
			result = m
		end)
		local _, sz = bboxOf(result)
		return { mode = "group", path = result:GetFullName(), count = #items, primaryPart = result.PrimaryPart and result.PrimaryPart.Name, size = { r1(sz.X), r1(sz.Y), r1(sz.Z) } }
	elseif mode == "ungroup" then
		local m = findInst(args.target)
		if not m then error("ungroup target not found: " .. tostring(args.target)) end
		if not m:IsA("Model") then error(m:GetFullName() .. " is not a Model") end
		local parent, moved = m.Parent, 0
		recorded("BuildKit ungroup", function()
			for _, c in ipairs(m:GetChildren()) do c.Parent = parent; moved += 1 end
			m.Parent = nil
		end)
		return { mode = "ungroup", moved = moved }
	else
		local m = findInst(args.target)
		if not m then error("weld target not found: " .. tostring(args.target)) end
		local anchor = m.PrimaryPart or (m:IsA("BasePart") and m) or m:FindFirstChildWhichIsA("BasePart", true)
		if not anchor then error("weld: no BasePart under " .. m:GetFullName()) end
		local made = 0
		recorded("BuildKit weld", function()
			for _, d in ipairs(m:GetDescendants()) do
				if d:IsA("BasePart") and d ~= anchor then
					local w = Instance.new("WeldConstraint")
					w.Part0 = anchor; w.Part1 = d; w.Parent = anchor
					d.Anchored = false
					made += 1
				end
			end
			anchor.Anchored = args.anchored ~= false
		end)
		return { mode = "weld", weldsMade = made, anchor = anchor:GetFullName() }
	end
end

-- console: read the Studio LogService output in-channel (edit-time). For PLAY-mode logs the official
-- get_console_output is better; this keeps edit-time prints/warnings/errors in one perceive channel.
function handlers.console(args)
	local LS = game:GetService("LogService")
	local hist = LS:GetLogHistory()
	local limit = math.clamp(tonumber(args.limit) or 50, 1, 300)
	local filter = args.filter and string.lower(tostring(args.filter)) or nil
	local onlyErr = args.errorsOnly == true
	local out = {}
	for i = #hist, 1, -1 do
		local e = hist[i]
		local isErr = e.messageType == Enum.MessageType.MessageError or e.messageType == Enum.MessageType.MessageWarning
		local pass = true
		if onlyErr and not isErr then pass = false end
		if pass and filter and not string.find(string.lower(e.message), filter, 1, true) then pass = false end
		if pass then
			out[#out + 1] = { t = (tostring(e.messageType):gsub("Enum.MessageType.Message", "")), msg = string.sub(e.message, 1, 400) }
			if #out >= limit then break end
		end
	end
	local rev = {}
	for i = #out, 1, -1 do rev[#rev + 1] = out[i] end
	return { count = #rev, lines = rev }
end

-- Hard savepoint: clone target (held parentless in this Lua session); restore swaps
-- it back (one undo step). Genuinely safer than the undo stack — the clone is NOT in
-- the datamodel, so rbx_undo/Ctrl+Z can't sweep it out. Cleared on Studio restart.
local checkpoints = {}
function handlers.checkpoint(args)
	local name = args.name or "checkpoint"
	if args.mode == "restore" then
		local cp = checkpoints[name]
		if not cp then
			error("no checkpoint named " .. tostring(name))
		end
		return recorded("BuildKit restore " .. name, function()
			local cur = cp.parent and cp.parent:FindFirstChild(cp.origName)
			if cur then
				cur.Parent = nil -- ponytail: Parent=nil not Destroy() so undo of a restore works
			end
			local fresh = cp.clone:Clone()
			fresh.Name = cp.origName
			fresh.Parent = cp.parent or workspace
			return { mode = "restore", name = name, restored = fresh:GetFullName() }
		end)
	end
	local inst = findInst(args.target)
	if not inst then
		error("target not found: " .. tostring(args.target))
	end
	if checkpoints[name] and checkpoints[name].clone then
		checkpoints[name].clone:Destroy()
	end
	local clone = inst:Clone()
	clone.Parent = nil -- ponytail: parentless + held by `checkpoints` ref = undo-proof; never enters the datamodel
	checkpoints[name] = { clone = clone, parent = inst.Parent, origName = inst.Name }
	local c, sz = bboxOf(inst)
	return { mode = "save", name = name, of = inst:GetFullName(), size = { r1(sz.X), r1(sz.Y), r1(sz.Z) } }
end

-- rbx_navcheck: PathfindingService walkability report between two points (name or
-- [x,y,z]), with an optional in-editor path visualization. Fills the official gap —
-- character_navigation only DRIVES a char, it doesn't QA whether a layout is navigable.
function handlers.navcheck(args)
	local PFS = game:GetService("PathfindingService")
	local function toV3(t)
		if type(t) == "table" and #t == 3 then return Vector3.new(t[1], t[2], t[3]) end
		local inst = findInst(t)
		if not inst then error("navcheck point not found: " .. tostring(t)) end
		return (bboxOf(inst))
	end
	local from, to = toV3(args.from), toV3(args.to)
	local path = PFS:CreatePath({
		AgentRadius = args.agentRadius or 2,
		AgentHeight = args.agentHeight or 5,
		AgentCanJump = args.agentCanJump ~= false,
		WaypointSpacing = args.waypointSpacing or 4,
	})
	local ok, err = pcall(function() path:ComputeAsync(from, to) end)
	local old = workspace:FindFirstChild("BuildKitNavPath") -- clear any prior viz
	if old then old:Destroy() end
	local res = { from = { r1(from.X), r1(from.Y), r1(from.Z) }, to = { r1(to.X), r1(to.Y), r1(to.Z) } }
	if not ok then res.status = "Error"; res.error = tostring(err); return res end
	local wps = path:GetWaypoints()
	res.status = path.Status.Name
	res.reachable = (path.Status == Enum.PathStatus.Success)
	res.waypointCount = #wps
	local len, jumps = 0, 0
	for i = 2, #wps do len = len + (wps[i].Position - wps[i - 1].Position).Magnitude end
	for _, w in ipairs(wps) do if w.Action == Enum.PathWaypointAction.Jump then jumps = jumps + 1 end end
	res.pathLength, res.jumps = r1(len), jumps
	if args.visualize and #wps > 0 then
		local folder = Instance.new("Folder"); folder.Name = "BuildKitNavPath"; folder.Parent = workspace
		for _, w in ipairs(wps) do
			local m = Instance.new("Part")
			m.Shape = Enum.PartType.Ball; m.Size = Vector3.new(0.6, 0.6, 0.6); m.Position = w.Position
			m.Anchored = true; m.CanCollide = false; m.CanQuery = false; m.Material = Enum.Material.Neon
			m.Color = (w.Action == Enum.PathWaypointAction.Jump) and Color3.fromRGB(255, 170, 0) or Color3.fromRGB(80, 200, 255)
			m.Parent = folder
		end
		res.visualized = "BuildKitNavPath (delete the folder to clear)"
	end
	return res
end

-- rbx_tag: CollectionService tags (gameplay wiring). add/remove (one undo) / list a
-- target's tags / query every instance carrying a tag. Cheaper + multi-agent-safe vs execute_luau.
function handlers.tag(args)
	local CS = game:GetService("CollectionService")
	local mode = args.mode
	if mode == "query" then
		local out = {}
		for _, inst in ipairs(CS:GetTagged(args.tag)) do out[#out + 1] = inst:GetFullName() end
		return { mode = "query", tag = args.tag, count = #out, instances = out }
	end
	local inst = findInst(args.target)
	if not inst then error("tag target not found: " .. tostring(args.target)) end
	if mode == "list" then return { mode = "list", target = inst:GetFullName(), tags = CS:GetTags(inst) } end
	if not args.tag or args.tag == "" then error("tag: need a tag name") end
	return recorded("BuildKit tag " .. tostring(mode), function()
		if mode == "add" then CS:AddTag(inst, args.tag)
		elseif mode == "remove" then CS:RemoveTag(inst, args.tag)
		else error("tag: unknown mode " .. tostring(mode)) end
		return { mode = mode, target = inst:GetFullName(), tag = args.tag, tags = CS:GetTags(inst) }
	end)
end

-- rbx_attr: instance Attributes. set (one undo) / get / list. value coerces JSON
-- primitives; a [x,y,z] array becomes a Vector3. Non-JSON values come back stringified.
-- (the runtime harness's `safe` lives inside RUNTIME_SOURCE, not this scope — attrs are
-- flat scalars/Vector3/Color3, so a one-level stringify is all we need.)
local function attrVal(v)
	local t = typeof(v)
	if t == "number" or t == "string" or t == "boolean" then return v end
	return tostring(v)
end
function handlers.attr(args)
	local inst = findInst(args.target)
	if not inst then error("attr target not found: " .. tostring(args.target)) end
	local mode = args.mode
	if mode == "list" then
		local out = {}
		for k, v in pairs(inst:GetAttributes()) do out[k] = attrVal(v) end
		return { mode = "list", target = inst:GetFullName(), attributes = out }
	end
	if mode == "get" then
		if not args.name or args.name == "" then error("attr get: need a name") end
		return { mode = "get", target = inst:GetFullName(), name = args.name, value = attrVal(inst:GetAttribute(args.name)) }
	end
	if not args.name or args.name == "" then error("attr set: need a name") end
	local v = args.value
	if type(v) == "table" and #v == 3 then v = Vector3.new(v[1], v[2], v[3]) end
	return recorded("BuildKit attr set", function()
		inst:SetAttribute(args.name, v)
		return { mode = "set", target = inst:GetFullName(), name = args.name, value = attrVal(inst:GetAttribute(args.name)) }
	end)
end

-- rbx_diff: compare two trees (each = a checkpoint NAME or a live instance name) and
-- report added/removed/changed (moved/resized/recolored/material/anchored), keyed by
-- path RELATIVE to each root so the root's own name differing doesn't matter.
function handlers.diff(args)
	local function resolveRoot(nm)
		if checkpoints[nm] and checkpoints[nm].clone then return checkpoints[nm].clone, "checkpoint:" .. nm end
		local inst = findInst(nm)
		if inst then return inst, inst:GetFullName() end
		return nil
	end
	local ra, la = resolveRoot(args.a)
	local rb, lb = resolveRoot(args.b)
	if not ra then error("diff: 'a' not found (checkpoint or instance): " .. tostring(args.a)) end
	if not rb then error("diff: 'b' not found (checkpoint or instance): " .. tostring(args.b)) end
	local function sig(root)
		local map = {}
		local function rel(d)
			local parts, cur = {}, d
			while cur and cur ~= root do parts[#parts + 1] = cur.Name; cur = cur.Parent end
			local s = ""
			for i = #parts, 1, -1 do s = s .. "/" .. parts[i] end
			return s == "" and "." or s
		end
		for _, d in ipairs(root:GetDescendants()) do
			local p = { class = d.ClassName }
			if d:IsA("BasePart") then
				p.pos, p.size, p.color, p.material, p.anchored = d.Position, d.Size, d.Color, d.Material.Name, d.Anchored
			end
			map[rel(d)] = p
		end
		return map
	end
	local ma, mb = sig(ra), sig(rb)
	local added, removed, changed = {}, {}, {}
	for k in pairs(mb) do if not ma[k] then added[#added + 1] = k end end
	for k, va in pairs(ma) do
		local vb = mb[k]
		if not vb then removed[#removed + 1] = k
		else
			local f = {}
			if va.class ~= vb.class then f.class = { va.class, vb.class } end
			if va.pos and vb.pos and (va.pos - vb.pos).Magnitude > 0.05 then f.moved = r1((va.pos - vb.pos).Magnitude) end
			if va.size and vb.size and (va.size - vb.size).Magnitude > 0.05 then f.resized = true end
			if va.color and vb.color and va.color ~= vb.color then f.recolored = true end
			if va.material and vb.material and va.material ~= vb.material then f.material = { va.material, vb.material } end
			if va.anchored ~= nil and va.anchored ~= vb.anchored then f.anchored = { va.anchored, vb.anchored } end
			if next(f) then changed[#changed + 1] = { path = k, fields = f } end
		end
	end
	local CAP = 100
	local function cap(t)
		if #t <= CAP then return t end
		local r = {}
		for i = 1, CAP do r[i] = t[i] end
		r[CAP + 1] = "... +" .. (#t - CAP) .. " more"
		return r
	end
	return {
		a = la, b = lb,
		addedCount = #added, removedCount = #removed, changedCount = #changed,
		added = cap(added), removed = cap(removed), changed = cap(changed),
	}
end

-- rbx_optimize: perf/streaming audit (extends rbx_qa to runtime cost). Counts parts,
-- flags Precise-collision MeshParts, unanchored geometry, far-from-origin parts, big
-- models, StreamingEnabled. fix=true lowers Precise->Box CollisionFidelity (one undo).
function handlers.optimize(args)
	local root = findInst(args.target) or workspace
	local parts, meshParts, unanchored, decals, far = 0, 0, 0, 0, 0
	local precise, bigModels = {}, {}
	for _, d in ipairs(root:GetDescendants()) do
		if d:IsA("BasePart") then
			parts = parts + 1
			if not d.Anchored then unanchored = unanchored + 1 end
			if d.Position.Magnitude > 10000 then far = far + 1 end
			if d:IsA("MeshPart") then
				meshParts = meshParts + 1
				if d.CollisionFidelity == Enum.CollisionFidelity.Precise then precise[#precise + 1] = d end
			end
		elseif d:IsA("Decal") or d:IsA("Texture") then
			decals = decals + 1
		elseif d:IsA("Model") then
			local c = 0
			for _, x in ipairs(d:GetDescendants()) do if x:IsA("BasePart") then c = c + 1 end end
			if c > 500 then bigModels[#bigModels + 1] = d.Name .. " (" .. c .. " parts)" end
		end
	end
	local streaming = workspace.StreamingEnabled
	local warnings = {}
	if #precise > 0 then warnings[#warnings + 1] = #precise .. " MeshParts use Precise CollisionFidelity (expensive; Box/Default suits static props — fix=true lowers them)" end
	if unanchored > 0 then warnings[#warnings + 1] = unanchored .. " unanchored parts (physics cost; anchor static geometry via rbx_edit anchor)" end
	if far > 0 then warnings[#warnings + 1] = far .. " parts >10000 studs from origin (float jitter risk)" end
	if not streaming and parts > 1000 then warnings[#warnings + 1] = "StreamingEnabled OFF with " .. parts .. " parts (enable it for large places to cut client memory)" end
	for _, m in ipairs(bigModels) do warnings[#warnings + 1] = "large model: " .. m end
	local fixed = 0
	if args.fix and #precise > 0 then
		recorded("BuildKit optimize", function()
			for _, mp in ipairs(precise) do mp.CollisionFidelity = Enum.CollisionFidelity.Box; fixed = fixed + 1 end
		end)
	end
	return {
		target = root:GetFullName(), totalParts = parts, meshParts = meshParts, decals = decals,
		unanchored = unanchored, preciseMeshes = #precise, streamingEnabled = streaming,
		warnings = warnings, fixedCollisionFidelity = fixed,
	}
end

-- Isolate: hide every BasePart not under `target` by Transparency=1 (NOT
-- reparent-to-nil — a lost restore must never orphan/GC a part) so a capture shows
-- only the object being built. mode='off' restores all isolates.
function handlers.isolate(args)
	if args.mode == "off" then
		local n = 0
		for token, hidden in pairs(cutStore) do
			if string.sub(token, 1, 3) == "iso" then
				for _, e in ipairs(hidden) do
					if e.inst and e.inst.Parent then
						pcall(function()
							e.inst.Transparency = e.transparency
						end)
					end
				end
				cutStore[token] = nil
				n += #hidden
			end
		end
		return { mode = "off", restored = n }
	end
	local keep = findInst(args.target)
	if not keep then
		error("target not found: " .. tostring(args.target))
	end
	local keepSet = { [keep] = true }
	for _, d in ipairs(keep:GetDescendants()) do
		keepSet[d] = true
	end
	local a = keep.Parent
	while a and a ~= game do
		keepSet[a] = true
		a = a.Parent
	end
	cutSeq += 1
	local token = "iso" .. cutSeq
	-- Skip Terrain (its Transparency isn't meaningful) and the target's own parts.
	local hidden = {}
	for _, d in ipairs(workspace:GetDescendants()) do
		if d:IsA("BasePart") and not d:IsA("Terrain") and not keepSet[d] then
			table.insert(hidden, { inst = d, transparency = d.Transparency })
			d.Transparency = 1
		end
	end
	cutStore[token] = hidden
	return { mode = "on", token = token, hiddenCount = #hidden }
end

-- Annotate: overlay a bbox outline + a "W x H x D" dimension label on the target
-- so the LLM can read scale/extent off the screenshot. mode='off' clears them.
local function clearAnno()
	local doomed = {}
	for _, root in ipairs({ game:GetService("CoreGui"), workspace }) do
		for _, d in ipairs(root:GetDescendants()) do
			if d:GetAttribute("BuildKitAnno") then
				table.insert(doomed, d)
			end
		end
	end
	for _, d in ipairs(doomed) do
		d:Destroy()
	end
	return #doomed
end
function handlers.annotate(args)
	if args.mode == "off" then
		return { mode = "off", cleared = clearAnno() }
	end
	local inst = findInst(args.target)
	if not inst then
		error("target not found: " .. tostring(args.target))
	end
	clearAnno()
	local center, size = bboxOf(inst)
	local coreGui = game:GetService("CoreGui")
	local box = Instance.new("SelectionBox")
	box.Adornee = inst
	box.LineThickness = math.max(0.03, size.Magnitude / 600)
	box.Color3 = Color3.fromRGB(255, 210, 80)
	box.SurfaceTransparency = 1
	box:SetAttribute("BuildKitAnno", true)
	box.Parent = coreGui
	local anchor = Instance.new("Part")
	anchor.Anchored = true
	anchor.CanCollide = false
	anchor.Transparency = 1
	anchor.Size = Vector3.new(0.1, 0.1, 0.1)
	anchor.CFrame = CFrame.new(center + Vector3.new(0, size.Y / 2 + 1, 0))
	anchor:SetAttribute("BuildKitAnno", true)
	anchor.Parent = workspace
	local bb = Instance.new("BillboardGui")
	bb.Adornee = anchor
	bb.Size = UDim2.fromOffset(230, 44)
	bb.AlwaysOnTop = true
	bb:SetAttribute("BuildKitAnno", true)
	local lab = Instance.new("TextLabel")
	lab.Size = UDim2.fromScale(1, 1)
	lab.BackgroundColor3 = Color3.new(0, 0, 0)
	lab.BackgroundTransparency = 0.35
	lab.Font = Enum.Font.GothamBold
	lab.TextSize = 18
	lab.TextColor3 = Color3.fromRGB(255, 210, 80)
	lab.Text = string.format("%.1f x %.1f x %.1f", size.X, size.Y, size.Z)
	lab.Parent = bb
	bb.Parent = coreGui
	return { mode = "on", target = inst.Name, size = { r1(size.X), r1(size.Y), r1(size.Z) } }
end

-- Contrast: recolor a target's parts in an alternating high-contrast flat palette so
-- seams/misalignment/gaps pop in a capture (pair with isolate=true to float it on the
-- sky). Stores originals; mode='off' restores all contrast stashes. Non-destructive.
local CONTRAST_PALETTE = {
	Color3.fromRGB(255, 64, 160), Color3.fromRGB(64, 220, 255), Color3.fromRGB(255, 220, 60),
	Color3.fromRGB(120, 255, 120), Color3.fromRGB(255, 140, 40), Color3.fromRGB(180, 120, 255),
}
function handlers.contrast(args)
	if args.mode == "off" then
		local n = 0
		for token, stash in pairs(cutStore) do
			if string.sub(token, 1, 4) == "cont" then
				for _, e in ipairs(stash) do
					if e.inst and e.inst.Parent then
						pcall(function()
							e.inst.Color = e.color
							e.inst.Material = e.material
						end)
					end
				end
				cutStore[token] = nil
				n += #stash
			end
		end
		return { mode = "off", restored = n }
	end
	local inst = findInst(args.target)
	if not inst then
		error("target not found: " .. tostring(args.target))
	end
	cutSeq += 1
	local token = "cont" .. cutSeq
	local stash = {}
	local i = 0
	for _, p in ipairs(partsOf(inst)) do
		table.insert(stash, { inst = p, color = p.Color, material = p.Material })
		i += 1
		p.Color = CONTRAST_PALETTE[(i % #CONTRAST_PALETTE) + 1]
		p.Material = Enum.Material.SmoothPlastic
	end
	cutStore[token] = stash
	return { mode = "on", token = token, count = #stash }
end

-- LAST RESORT play-mode harness. Inject the Script so it runs during Play. Can't
-- set LoadStringEnabled (not script-accessible) — the user ticks it in Properties.
function handlers.runtime_install()
	local sss = game:GetService("ServerScriptService")
	local existing = sss:FindFirstChild("BuildKitRuntime")
	if existing then
		existing:Destroy()
	end
	local s = Instance.new("Script")
	s.Name = "BuildKitRuntime"
	s.Source = RUNTIME_SOURCE
	s.Parent = sss
	local httpOk = pcall(function()
		game:GetService("HttpService").HttpEnabled = true
	end)
	return {
		installed = true,
		name = "BuildKitRuntime",
		httpEnabled = httpOk,
		hint = "LAST RESORT — prefer official execute_luau(Server/Client). Before Play: tick ServerScriptService.LoadStringEnabled in Properties"
			.. (httpOk and "" or " AND enable HttpService.HttpEnabled (the plugin couldn't set it)")
			.. ". Then start_stop_play, then rbx_run.",
	}
end

function handlers.runtime_remove()
	local sss = game:GetService("ServerScriptService")
	local s = sss:FindFirstChild("BuildKitRuntime")
	local had = s ~= nil
	if s then
		s:Destroy()
	end
	return { removed = had }
end

-- Run several build/edit ops as ONE undo step + one round trip. Each op is
-- { action = "build"|"edit", args = {...} } where args is what that handler takes.
-- Nested recorded() no-ops (TryBeginRecording returns nil while one is open), so
-- the outer recording owns the whole batch — if any op errors it Cancels = atomic.
local BATCHABLE = { build = true, edit = true }
function handlers.batch(args)
	local ops = args.ops or {}
	return recorded("BuildKit batch (" .. #ops .. ")", function()
		local results = {}
		for i, op in ipairs(ops) do
			local action = op.action
			if not BATCHABLE[action] then
				error("batch op " .. i .. ": action not batchable: " .. tostring(action))
			end
			results[i] = handlers[action](op.args or {})
		end
		return { count = #ops, results = results }
	end)
end

-- Insert a marketplace/toolbox asset by id (InsertService:LoadAsset) so the buildkit
-- doesn't need the official insert_model. Anchors parts, parents + positions + names
-- the result. Fails clearly if the asset isn't loadable (private/not owned).
function handlers.insert(args)
	local assetId = tonumber(args.assetId or args.id)
	if not assetId then error("insert needs a numeric assetId") end
	return recorded("BuildKit insert " .. assetId, function()
		local ok, asset = pcall(function()
			return game:GetService("InsertService"):LoadAsset(assetId)
		end)
		if not ok or not asset then
			error("LoadAsset(" .. assetId .. ") failed (asset must be free or owned by you): " .. tostring(asset))
		end
		local target = (args.parent and workspace:FindFirstChild(args.parent)) or workspace
		local inserted = {}
		for _, child in ipairs(asset:GetChildren()) do
			child.Parent = target
			inserted[#inserted + 1] = child
			if child:IsA("BasePart") then child.Anchored = (args.anchored ~= false) end
			for _, d in ipairs(child:GetDescendants()) do
				if d:IsA("BasePart") then d.Anchored = (args.anchored ~= false) end
			end
		end
		asset:Destroy()
		local first = inserted[1]
		if first then
			if args.name then first.Name = args.name end
			if args.position then
				local p = Vector3.new(args.position[1], args.position[2], args.position[3])
				if first:IsA("Model") then
					first:PivotTo(CFrame.new(p))
				elseif first:IsA("BasePart") then
					first.Position = p
				end
			end
		end
		return { inserted = #inserted, name = first and first.Name or nil }
	end)
end

-- Push disk script source into the DataModel (rbx_sync). Each item is
-- { dmPath = {Service, ...folders, LeafName}, className, source, file }.
-- Missing parent folders are created; an existing leaf of the right class has
-- its Source updated, a wrong-class leaf is replaced (children re-parented).
local SYNC_CLASSES = { Script = true, LocalScript = true, ModuleScript = true }
function handlers.sync(args)
	local items = args.items or {}
	if #items == 0 then error("sync: no items") end
	return recorded("BuildKit Sync", function()
		local Selection = game:GetService("Selection")
		local synced, results = {}, {}
		local created, updated, replaced = 0, 0, 0
		for _, item in ipairs(items) do
			local dmPath = item.dmPath
			if type(dmPath) ~= "table" or #dmPath < 2 then
				error("sync: bad dmPath (need {Service,...,Leaf})")
			end
			local cls = item.className or "ModuleScript"
			if not SYNC_CLASSES[cls] then error("sync: bad className " .. tostring(cls)) end
			local ok, root = pcall(function() return game:GetService(dmPath[1]) end)
			if not ok or not root then error("sync: unknown service '" .. tostring(dmPath[1]) .. "'") end
			-- walk/create intermediate folders
			local parent = root
			for i = 2, #dmPath - 1 do
				local name = dmPath[i]
				local child = parent:FindFirstChild(name)
				if not child then
					child = Instance.new("Folder")
					child.Name = name
					child.Parent = parent
				end
				parent = child
			end
			-- leaf
			local leafName = dmPath[#dmPath]
			local src = item.source or ""
			local existing = parent:FindFirstChild(leafName)
			local inst, action
			-- EXACT class match, NOT :IsA: LocalScript:IsA("Script") is true, so :IsA would
			-- update server source in place onto a LocalScript (wrong run context). ClassName ==
			-- forces a real replace when the script class changes (.luau<->.server<->.client).
			if existing and existing.ClassName == cls then
				existing.Source = src
				inst, action = existing, "updated"
				updated = updated + 1
			elseif existing then
				inst = Instance.new(cls)
				inst.Name = leafName
				inst.Source = src
				-- carry over manual Studio-side state that has no disk source, so a class change
				-- doesn't silently re-enable/untag a script: attributes, tags, Disabled, children.
				for k, v in pairs(existing:GetAttributes()) do inst:SetAttribute(k, v) end
				local CollectionService = game:GetService("CollectionService")
				for _, tag in ipairs(CollectionService:GetTags(existing)) do CollectionService:AddTag(inst, tag) end
				if not inst:IsA("ModuleScript") and not existing:IsA("ModuleScript") then
					pcall(function() inst.Disabled = existing.Disabled end)
				end
				for _, c in ipairs(existing:GetChildren()) do c.Parent = inst end
				inst.Parent = parent
				existing:Destroy()
				action = "replaced"
				replaced = replaced + 1
			else
				inst = Instance.new(cls)
				inst.Name = leafName
				inst.Source = src
				inst.Parent = parent
				action = "created"
				created = created + 1
			end
			synced[#synced + 1] = inst
			results[#results + 1] = { path = inst:GetFullName(), action = action, file = item.file }
		end
		if args.select ~= false and #synced > 0 then
			pcall(function() Selection:Set(synced) end)
		end
		return { items = results, created = created, updated = updated, replaced = replaced }
	end)
end

function handlers.build(spec)
	spec = spec or {}
	-- Tolerate an accidental double-wrap ({spec={kind=...}}) from a client that
	-- nested the payload one level too deep.
	if spec.spec and not spec.kind then
		spec = spec.spec
	end
	if not spec.kind then
		local keys = {}
		for k in pairs(spec) do
			keys[#keys + 1] = tostring(k)
		end
		error("build: missing 'kind' (got nil). spec keys = {" .. table.concat(keys, ", ") .. "}")
	end
	return recorded("BuildKit build " .. tostring(spec.kind), function()
		prepSpec(spec) -- apply era preset + real-proportion default size before building
		buildWarnings = {} -- reset primitive-guard warnings for this build (shared upvalue with makePart)
		local model
		if spec.kind == "room" then
			model = buildRoom(spec)
		elseif spec.kind == "stairs" then
			model = buildStairs(spec)
		elseif spec.kind == "slab" then
			model = buildSlab(spec)
		elseif spec.kind == "cabinet" then
			model = buildCabinet(spec)
		elseif spec.kind == "table" then
			model = buildTable(spec)
		elseif spec.kind == "shelf" then
			model = buildShelf(spec)
		elseif spec.kind == "bed" then
			model = buildBed(spec)
		elseif spec.kind == "chair" then
			model = buildChair(spec)
		elseif spec.kind == "sofa" then
			model = buildSeating(spec, math.max(2, math.floor(spec.seats or 3)))
		elseif spec.kind == "armchair" then
			model = buildSeating(spec, 1)
		elseif spec.kind == "desk" then
			model = buildDesk(spec)
		elseif spec.kind == "nightstand" then
			model = buildNightstand(spec)
		elseif spec.kind == "dresser" then
			model = buildDresser(spec)
		elseif spec.kind == "wardrobe" then
			model = buildWardrobe(spec)
		elseif spec.kind == "fridge" then
			model = buildFridge(spec)
		elseif spec.kind == "stove" then
			model = buildStove(spec)
		elseif spec.kind == "toilet" then
			model = buildToilet(spec)
		elseif spec.kind == "bathtub" then
			model = buildBathtub(spec)
		elseif spec.kind == "prop" then
			model = buildProp(spec)
		else
			error("unknown build kind: " .. tostring(spec.kind))
		end
		-- opt-in quality pass (csg shell / weathering), then make it parametric
		applyQuality(model, spec)
		tagBuildKit(model, spec)
		watchBuildKit(model)
		local parts = 0
		for _, d in ipairs(model:GetDescendants()) do
			if d:IsA("BasePart") then
				parts += 1
			end
		end
		local bc, bsz = bboxOf(model)
			-- Auto-QA: unless the panel toggle is off, scan the just-built model for
			-- z-fights (auto-nudged), deep overlaps, and unjoined/floating pieces, and
			-- return a compact report so correctness issues always surface.
			local qa = nil
			local autoQA = plugin:GetSetting("bk_autoQA")
			if autoQA == nil then autoQA = true end
			if autoQA and qaScan then
				local ok, r = pcall(qaScan, model, true)
				if ok and type(r) == "table" then
					qa = {
						zfights = #r.zFights,
						fixed = r.fixed,
						seated = r.seated,
						unjoined = #r.nearGaps,
						overlaps = #r.deepOverlaps,
						warnings = r.warnings,
					}
				end
			end
			-- D: surface primitive guards (ball-collapse / degenerate) + prop oversize, even if auto-QA off.
			local extra = {}
			for _, w in ipairs(buildWarnings) do extra[#extra + 1] = w end
			if spec.kind == "prop" then
				local md = math.max(bsz.X, bsz.Y, bsz.Z)
				if md > 24 then
					extra[#extra + 1] = string.format("prop is %.0f studs (largest dim) — likely oversized for a prop", md)
				end
			end
			if #extra > 0 then
				qa = qa or { zfights = 0, fixed = 0, seated = 0, unjoined = 0, overlaps = 0, warnings = {} }
				qa.warnings = qa.warnings or {}
				for _, w in ipairs(extra) do
					table.insert(qa.warnings, w)
				end
			end
			return {
				model = model.Name,
				parts = parts,
				center = { r1(bc.X), r1(bc.Y), r1(bc.Z) },
				size = { r1(bsz.X), r1(bsz.Y), r1(bsz.Z) },
				qa = qa,
			}
	end)
end

-- Build a styled ScreenGui: real copy into StarterGui (shows at gameplay), an
-- edit-time preview clone into CoreGui (renders in the edit viewport). Same name
-- replaces both. CoreGui previews are tagged with a BuildKitPreview attribute.
local function clearPreview(coreGui, name)
	local n = 0
	for _, ch in ipairs(coreGui:GetChildren()) do
		local tag = ch:GetAttribute("BuildKitPreview")
		if (name == nil and tag ~= nil) or tag == name then
			ch:Destroy()
			n += 1
		end
	end
	return n
end

function handlers.build_gui(spec)
	if not spec or not spec.root then
		error("build_gui needs a root node")
	end
	return recorded("BuildKit GUI " .. tostring(spec.name or "Gui"), function()
	local theme = gmerge(GUI_DEFAULT_THEME, spec.theme or {})
	local name = spec.name or "BuildKitGui"

	local sg = Instance.new("ScreenGui")
	sg.Name = name
	sg.ResetOnSpawn = false
	sg.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
	sg.IgnoreGuiInset = (spec.root.ignoreInset == true)
	sg.Enabled = (spec.enabled ~= false)

	local root = buildNode(spec.root, theme, nil)
	root.Parent = sg

	local starter = game:GetService("StarterGui")
	local old = starter:FindFirstChild(name)
	if old then
		old:Destroy()
	end
	sg.Parent = starter

	local coreGui = game:GetService("CoreGui")
	clearPreview(coreGui, name)
	local preview = sg:Clone()
	preview.Name = name .. "__preview"
	preview.Enabled = true
	preview:SetAttribute("BuildKitPreview", name)
	preview.Parent = coreGui

	local vp = workspace.CurrentCamera.ViewportSize
	return {
		name = name,
		enabled = sg.Enabled,
		instances = #sg:GetDescendants(),
		viewport = { vp.X, vp.Y },
	}
	end)
end

function handlers.gui_preview(args)
	local coreGui = game:GetService("CoreGui")
	local name = args.name
	if args.mode == "off" then
		return { mode = "off", cleared = clearPreview(coreGui, name) }
	end
	local starter = game:GetService("StarterGui")
	local src = starter:FindFirstChild(name)
	if not src then
		error("no ScreenGui named '" .. tostring(name) .. "' in StarterGui")
	end
	clearPreview(coreGui, name)
	local preview = src:Clone()
	preview.Name = name .. "__preview"
	preview.Enabled = true
	preview:SetAttribute("BuildKitPreview", name)
	preview.Parent = coreGui
	local vp = workspace.CurrentCamera.ViewportSize
	return { mode = "on", viewport = { vp.X, vp.Y } }
end

local lightStash = {}
function handlers.set_lighting(args)
	if args.mode == "day" then
		if lightStash.ClockTime == nil then
			lightStash.ClockTime = Lighting.ClockTime
			lightStash.Brightness = Lighting.Brightness
			lightStash.Ambient = Lighting.Ambient
			lightStash.OutdoorAmbient = Lighting.OutdoorAmbient
			lightStash.ExposureCompensation = Lighting.ExposureCompensation
		end
		Lighting.ClockTime = 14
		Lighting.Brightness = 2
		Lighting.Ambient = Color3.fromRGB(120, 120, 120)
		Lighting.OutdoorAmbient = Color3.fromRGB(140, 140, 140)
		Lighting.ExposureCompensation = 0
		return { mode = "day" }
	else
		if lightStash.ClockTime ~= nil then
			Lighting.ClockTime = lightStash.ClockTime
			Lighting.Brightness = lightStash.Brightness
			Lighting.Ambient = lightStash.Ambient
			Lighting.OutdoorAmbient = lightStash.OutdoorAmbient
			Lighting.ExposureCompensation = lightStash.ExposureCompensation
			lightStash = {}
		end
		return { mode = "noir" }
	end
end

-- ---------- long-poll loop ---------------------------------------------------
local function post(path, body)
	pcall(function()
		HttpService:RequestAsync({
			Url = BASE .. path,
			Method = "POST",
			Headers = { ["Content-Type"] = "application/json" },
			Body = HttpService:JSONEncode(body),
		})
	end)
end

-- Config defaults so the Settings panel is pre-filled and the bridge gets seeded AUTOMATICALLY
-- on first connect — no manual Save needed. plugin:GetSetting overrides these once the user edits.
-- SECURITY: openCloudKey is intentionally BLANK here — never hardcode it. Paste it into the
-- BuildKit Settings panel (it lives only in plugin:SetSetting + the in-memory /config bridge,
-- never in this source, the .rbxmx artifact, or any place/game file).
local CONFIG_FIELDS = { "openCloudKey", "creatorId", "creatorType", "comfyUrl", "hunyuanUrl" }
local CONFIG_DEFAULTS = {
	openCloudKey = "",
	creatorId = "0",
	creatorType = "User",
	comfyUrl = "http://127.0.0.1:8000",
	hunyuanUrl = "",
}
local CONFIG_MODES = { "primitives", "officialGen", "meshRef", "localImport", "autoQA" }
local function cfgGet(k, d)
	local v = plugin:GetSetting("bk_" .. k)
	if v == nil or v == "" then return d end
	return v
end
local function readSavedConfig()
	local cfg = { modes = {} }
	for _, k in ipairs(CONFIG_FIELDS) do
		local v = cfgGet(k, CONFIG_DEFAULTS[k])
		if v ~= nil then cfg[k] = v end
	end
	for _, m in ipairs(CONFIG_MODES) do
		cfg.modes[m] = (plugin:GetSetting("bk_" .. m) ~= false)
	end
	return cfg
end
local configPushed = false
local function pushSavedConfig()
	configPushed = true
	post("/config", readSavedConfig())
end

task.spawn(function()
	while true do
		if not RUNNING then
			task.wait(0.5)
			continue
		end
		local ok, res = pcall(function()
			return HttpService:RequestAsync({ Url = BASE .. "/poll?place=" .. HttpService:UrlEncode(PLACE), Method = "GET" })
		end)
		if ok and res and res.Success and not configPushed then
			pushSavedConfig() -- seed the MCP bridge with saved/default creds once it's reachable
		end
		if ok and res and res.Success and res.Body and #res.Body > 0 then
			local okd, cmd = pcall(function()
				return HttpService:JSONDecode(res.Body)
			end)
			if okd and cmd and cmd.id then
				local handler = handlers[cmd.action]
				local result, err
				if handler then
					local ok2, r = pcall(handler, cmd.args or {})
					if ok2 then
						result = r
					else
						err = tostring(r)
					end
				else
					err = "unknown action: " .. tostring(cmd.action)
				end
				post("/result", { id = cmd.id, ok = (err == nil), result = result, error = err })
			end
		elseif not ok then
			task.wait(1.0) -- server down; back off
		end
	end
end)

-- ---------- toolbar toggle ---------------------------------------------------
local toolbar = plugin:CreateToolbar("BuildKit")
local btn = toolbar:CreateButton("BuildKit", "Toggle BuildKit polling", "")
btn:SetActive(RUNNING)
btn.Click:Connect(function()
	RUNNING = not RUNNING
	btn:SetActive(RUNNING)
	print("[BuildKit] polling " .. (RUNNING and "ON" or "OFF"))
end)

print("[BuildKit] plugin loaded, polling " .. BASE)

-- ---------- settings dock widget --------------------------------------------
-- A dockable panel for connection creds (Open Cloud key, Creator ID, ComfyUI URL,
-- Hunyuan endpoint) + build-mode toggles. Persists locally via plugin:SetSetting and
-- pushes config to the MCP server over the bridge (POST /config) so the server can do
-- Open Cloud mesh uploads + reach ComfyUI. The key never lands in a place file.
local function getS(k, d) local v = plugin:GetSetting("bk_" .. k); if v == nil then return d end return v end
local function setS(k, v) plugin:SetSetting("bk_" .. k, v) end

local okWidget, widget = pcall(function()
	return plugin:CreateDockWidgetPluginGui("BuildKitSettings",
		DockWidgetPluginGuiInfo.new(Enum.InitialDockState.Right, false, false, 340, 580, 300, 460))
end)
if okWidget and widget then
	widget.Title = "BuildKit Settings"
	local root = Instance.new("Frame")
	root.Size = UDim2.fromScale(1, 1); root.BackgroundColor3 = Color3.fromRGB(34, 36, 42); root.BorderSizePixel = 0; root.Parent = widget
	local scroll = Instance.new("ScrollingFrame")
	scroll.Size = UDim2.new(1, -12, 1, -52); scroll.Position = UDim2.fromOffset(6, 6); scroll.BackgroundTransparency = 1
	scroll.BorderSizePixel = 0; scroll.ScrollBarThickness = 6; scroll.CanvasSize = UDim2.new(0, 0, 0, 920); scroll.Parent = root
	local layout = Instance.new("UIListLayout"); layout.Padding = UDim.new(0, 5); layout.SortOrder = Enum.SortOrder.LayoutOrder; layout.Parent = scroll
	local ord = 0
	local function lbl(text, color, h)
		local t = Instance.new("TextLabel")
		t.Size = UDim2.new(1, 0, 0, h or 18); t.BackgroundTransparency = 1; t.Text = text
		t.TextColor3 = color or Color3.fromRGB(210, 212, 218); t.TextXAlignment = Enum.TextXAlignment.Left
		t.Font = Enum.Font.Gotham; t.TextSize = 13; ord = ord + 1; t.LayoutOrder = ord; t.Parent = scroll
		return t
	end
	local boxes = {}
	local function field(key, placeholder)
		lbl(placeholder, Color3.fromRGB(150, 152, 160), 15)
		local b = Instance.new("TextBox")
		b.Size = UDim2.new(1, 0, 0, 26); b.BackgroundColor3 = Color3.fromRGB(24, 26, 30); b.TextColor3 = Color3.fromRGB(230, 232, 238)
		b.Text = tostring(getS(key, CONFIG_DEFAULTS[key] or "")); b.ClearTextOnFocus = false; b.Font = Enum.Font.Code; b.TextSize = 13
		b.TextXAlignment = Enum.TextXAlignment.Left; b.PlaceholderText = placeholder; ord = ord + 1; b.LayoutOrder = ord; b.Parent = scroll
		local pad = Instance.new("UIPadding"); pad.PaddingLeft = UDim.new(0, 6); pad.Parent = b
		boxes[key] = b
	end
	local toggles = {}
	local function toggleBtn(key, label, default)
		local on = getS(key, default)
		local btn2 = Instance.new("TextButton")
		btn2.Size = UDim2.new(1, 0, 0, 26); btn2.Font = Enum.Font.GothamMedium; btn2.TextSize = 13; btn2.AutoButtonColor = false
		btn2.TextXAlignment = Enum.TextXAlignment.Left; ord = ord + 1; btn2.LayoutOrder = ord; btn2.Parent = scroll
		local pad = Instance.new("UIPadding"); pad.PaddingLeft = UDim.new(0, 8); pad.Parent = btn2
		local function paint()
			btn2.BackgroundColor3 = on and Color3.fromRGB(56, 132, 86) or Color3.fromRGB(46, 48, 54)
			btn2.TextColor3 = Color3.fromRGB(235, 237, 242); btn2.Text = (on and "[x]  " or "[  ]  ") .. label
		end
		paint()
		btn2.MouseButton1Click:Connect(function() on = not on; paint() end)
		toggles[key] = function() return on end
	end

	lbl("CONNECTIONS", Color3.fromRGB(120, 200, 255), 22)
	field("openCloudKey", "Open Cloud API key")
	field("creatorId", "Creator ID")
	field("creatorType", "Creator type (User/Group)")
	field("comfyUrl", "ComfyUI server URL (http://ip:8188)")
	field("hunyuanUrl", "Hunyuan3D endpoint (optional)")
	lbl("BUILD MODES", Color3.fromRGB(120, 200, 255), 22)
	toggleBtn("primitives", "Primitives (lightweight)", true)
	toggleBtn("officialGen", "Official AI gen (mesh/proc)", true)
	toggleBtn("meshRef", "Use meshes as reference", true)
	toggleBtn("localImport", "Local-gen import (ComfyUI+Hunyuan)", false)
	toggleBtn("autoQA", "Auto-QA every build", true)
	lbl("STATUS", Color3.fromRGB(120, 200, 255), 22)
	local statusLbl = lbl("not saved yet", Color3.fromRGB(180, 182, 190), 18)

	local bar = Instance.new("Frame")
	bar.Size = UDim2.new(1, -12, 0, 40); bar.Position = UDim2.new(0, 6, 1, -46); bar.BackgroundTransparency = 1; bar.Parent = root
	local function mkBtn(txt, col, xs)
		local b = Instance.new("TextButton"); b.Size = UDim2.new(0.5, -4, 1, 0); b.Position = UDim2.new(xs, xs > 0 and 4 or 0, 0, 0)
		b.BackgroundColor3 = col; b.TextColor3 = Color3.fromRGB(255, 255, 255); b.Font = Enum.Font.GothamBold; b.TextSize = 14; b.Text = txt; b.Parent = bar
		return b
	end
	local saveBtn = mkBtn("Save", Color3.fromRGB(70, 150, 235), 0)
	local testBtn = mkBtn("Test", Color3.fromRGB(60, 64, 72), 0.5)
	local function gather()
		local cfg = { modes = {} }
		for k, b in pairs(boxes) do cfg[k] = b.Text end
		for k, getter in pairs(toggles) do cfg.modes[k] = getter() end
		return cfg
	end
	saveBtn.MouseButton1Click:Connect(function()
		for k, b in pairs(boxes) do setS(k, b.Text) end
		for k, getter in pairs(toggles) do setS(k, getter()) end
		post("/config", gather())
		statusLbl.Text = "saved -> local config file (~/.buildkit/config.json)"
		statusLbl.TextColor3 = Color3.fromRGB(120, 220, 140)
	end)
	testBtn.MouseButton1Click:Connect(function()
		post("/config", gather())
		statusLbl.Text = "config sent (check server / Test endpoints)"
		statusLbl.TextColor3 = Color3.fromRGB(220, 200, 120)
	end)

	local setBtn = toolbar:CreateButton("Settings", "BuildKit settings panel", "")
	setBtn.Click:Connect(function() widget.Enabled = not widget.Enabled end)
end

-- ---------- Mesh Cutter (EditableMesh) --------------------------------------
-- Interactive in-Studio mesh editor: drop a draggable plane on a MeshPart, click Cut, and it
-- splits into two CAPPED MeshParts (clean plane-bisect that splits crossing triangles + a flat
-- fill at the cut so the piece has an interior, not a see-through shell). Each cut is one undo
-- step (Ctrl+Z). "Make Openable" turns a two-piece cut into a hinged chest. No Blender, no
-- re-upload — all via AssetService EditableMesh on the mesh already in the place.
do -- own scope so these locals don't count against the main chunk's local budget
local AssetService = game:GetService("AssetService")
local ChangeHistoryService = game:GetService("ChangeHistoryService")
local Selection = game:GetService("Selection")

-- Split mp by a world plane (point + unit normal) into two capped MeshParts. pA = +normal side,
-- pB = -normal side. Each half is re-placed at its own world bbox-centre so the two pieces
-- reassemble exactly where the original sat (Roblox keeps a part's geometry centred on its origin).
local function bisectMeshPart(mp, planePos, planeNormal)
	local src = AssetService:CreateEditableMeshAsync(Content.fromUri(mp.MeshId))
	local emA, emB = AssetService:CreateEditableMesh(), AssetService:CreateEditableMesh()
	local cf = mp.CFrame
	local cap = {}
	local loA, hiA, loB, hiB
	local function acc(p, isA)
		if isA then
			loA = loA and Vector3.new(math.min(loA.X, p.X), math.min(loA.Y, p.Y), math.min(loA.Z, p.Z)) or p
			hiA = hiA and Vector3.new(math.max(hiA.X, p.X), math.max(hiA.Y, p.Y), math.max(hiA.Z, p.Z)) or p
		else
			loB = loB and Vector3.new(math.min(loB.X, p.X), math.min(loB.Y, p.Y), math.min(loB.Z, p.Z)) or p
			hiB = hiB and Vector3.new(math.max(hiB.X, p.X), math.max(hiB.Y, p.Y), math.max(hiB.Z, p.Z)) or p
		end
	end
	local function addTri(em, a, b, c, isA)
		em:AddTriangle(em:AddVertex(a), em:AddVertex(b), em:AddVertex(c))
		acc(a, isA); acc(b, isA); acc(c, isA)
	end
	local function sd(localPos) return (cf:PointToWorldSpace(localPos) - planePos):Dot(planeNormal) end
	for _, f in ipairs(src:GetFaces()) do
		local fv = src:GetFaceVertices(f)
		local p = { src:GetPosition(fv[1]), src:GetPosition(fv[2]), src:GetPosition(fv[3]) }
		local d = { sd(p[1]), sd(p[2]), sd(p[3]) }
		local ab, be = {}, {}
		for i = 1, 3 do if d[i] >= 0 then ab[#ab + 1] = i else be[#be + 1] = i end end
		if #ab == 3 then addTri(emA, p[1], p[2], p[3], true)
		elseif #be == 3 then addTri(emB, p[1], p[2], p[3], false)
		else
			local oneA = (#ab == 1)
			local lone = oneA and ab[1] or be[1]
			local many = oneA and be or ab
			local function it(ia, ib) local t = d[ia] / (d[ia] - d[ib]); return p[ia] + (p[ib] - p[ia]) * t end
			local i1, i2 = it(lone, many[1]), it(lone, many[2])
			cap[#cap + 1] = i1; cap[#cap + 1] = i2
			addTri(oneA and emA or emB, p[lone], i1, i2, oneA)
			addTri(oneA and emB or emA, p[many[1]], p[many[2]], i2, not oneA)
			addTri(oneA and emB or emA, p[many[1]], i2, i1, not oneA)
		end
	end
	if #cap >= 3 then -- flat cap: fan the cut boundary from its centroid (angle-sorted in-plane)
		local cen = Vector3.zero
		for _, q in ipairs(cap) do cen = cen + q end
		cen = cen / #cap
		local nL = cf:VectorToObjectSpace(planeNormal).Unit
		local up = math.abs(nL.Y) < 0.9 and Vector3.yAxis or Vector3.xAxis
		local a1 = up:Cross(nL).Unit
		local a2 = nL:Cross(a1).Unit
		table.sort(cap, function(x, y)
			local dx, dy = x - cen, y - cen
			return math.atan2(dx:Dot(a2), dx:Dot(a1)) < math.atan2(dy:Dot(a2), dy:Dot(a1))
		end)
		for i = 1, #cap do
			local a, b = cap[i], cap[(i % #cap) + 1]
			addTri(emA, cen, a, b, true)
			addTri(emB, cen, b, a, false)
		end
	end
	local pA = AssetService:CreateMeshPartAsync(Content.fromObject(emA))
	local pB = AssetService:CreateMeshPartAsync(Content.fromObject(emB))
	for _, pr in ipairs({ pA, pB }) do
		pr.Anchored = true; pr.Color = mp.Color; pr.Material = mp.Material
		pcall(function() pr.DoubleSided = true end) -- inner shell visible -> reads solid, not see-through
	end
	if loA then pA.CFrame = cf * CFrame.new((loA + hiA) / 2) end
	if loB then pB.CFrame = cf * CFrame.new((loB + hiB) / 2) end
	return pA, pB
end

-- cutter state + helpers
local cutTarget, cutterPart = nil, nil
local function clearCutter() if cutterPart then cutterPart:Destroy() end; cutterPart = nil end
local function spawnCutter(mp)
	clearCutter()
	cutTarget = mp
	local s = mp.Size
	local c = Instance.new("Part")
	c.Name = "MeshCutterPlane"; c.Anchored = true; c.CanCollide = false; c.CanQuery = false
	c.Size = Vector3.new(math.max(s.X, s.Z) * 1.5, 0.05, math.max(s.X, s.Z) * 1.5)
	c.CFrame = CFrame.new(mp.Position) -- horizontal at mesh centre; normal = UpVector (+Y)
	c.Color = Color3.fromRGB(70, 160, 255); c.Material = Enum.Material.Neon; c.Transparency = 0.5
	c.Parent = workspace
	cutterPart = c
	Selection:Set({ c }) -- ready to move/rotate with Studio's tools
end
local function doCut()
	if not (cutTarget and cutTarget.Parent and cutterPart) then return "Select a MeshPart, then Add Cutter, then Cut." end
	local mp, planePos, planeNormal = cutTarget, cutterPart.Position, cutterPart.CFrame.UpVector
	local rec = ChangeHistoryService:TryBeginRecording("BuildKit cut mesh")
	local ok, pA, pB = pcall(bisectMeshPart, mp, planePos, planeNormal)
	if not ok or not (pA and pB) then
		if rec then ChangeHistoryService:FinishRecording(rec, Enum.FinishRecordingOperation.Cancel) end
		return "Cut failed: " .. tostring(pA)
	end
	local model = Instance.new("Model")
	model.Name = mp.Name .. "_Cut"; model.Parent = mp.Parent
	if pA.Position.Y >= pB.Position.Y then pA.Name = "Lid"; pB.Name = "Base" else pA.Name = "Base"; pB.Name = "Lid" end
	pA.Parent = model; pB.Parent = model
	model.PrimaryPart = model:FindFirstChild("Base")
	mp:Destroy(); clearCutter(); cutTarget = nil
	Selection:Set({ model })
	if rec then ChangeHistoryService:FinishRecording(rec, Enum.FinishRecordingOperation.Commit) end
	return "Cut into Base + Lid. (Ctrl+Z to undo.)"
end
local function makeOpenable()
	local sel = Selection:Get()[1]
	local model = sel and (sel:IsA("Model") and sel or sel.Parent)
	if not (model and model:IsA("Model")) then return "Select a cut Model (Base+Lid) first." end
	local lid, base = model:FindFirstChild("Lid"), model:FindFirstChild("Base")
	if not (lid and base) then return "Model needs a Base + Lid — cut it first." end
	if model:FindFirstChild("ChestController") then return "Already openable." end
	local rec = ChangeHistoryService:TryBeginRecording("BuildKit make openable")
	local s = Instance.new("Script"); s.Name = "ChestController"; s.Source = CHEST_LID_SOURCE; s.Parent = model
	if rec then ChangeHistoryService:FinishRecording(rec, Enum.FinishRecordingOperation.Commit) end
	return "Added open/close controller. Press Play, walk up, use the prompt."
end

local cutBtn = toolbar:CreateButton("Mesh Cutter", "Cut a mesh into openable parts", "")
local okCW, cutWidget = pcall(function()
	return plugin:CreateDockWidgetPluginGui("BuildKitMeshCutter",
		DockWidgetPluginGuiInfo.new(Enum.InitialDockState.Right, false, false, 300, 360, 260, 320))
end)
if okCW and cutWidget then
	cutWidget.Title = "BuildKit Mesh Cutter"
	local cr = Instance.new("Frame")
	cr.Size = UDim2.fromScale(1, 1); cr.BackgroundColor3 = Color3.fromRGB(34, 36, 42); cr.BorderSizePixel = 0; cr.Parent = cutWidget
	local cl = Instance.new("UIListLayout"); cl.Padding = UDim.new(0, 8); cl.SortOrder = Enum.SortOrder.LayoutOrder
	cl.HorizontalAlignment = Enum.HorizontalAlignment.Center; cl.Parent = cr
	local cpad = Instance.new("UIPadding"); cpad.PaddingTop = UDim.new(0, 10); cpad.PaddingLeft = UDim.new(0, 10); cpad.PaddingRight = UDim.new(0, 10); cpad.Parent = cr
	local function clbl(text, color, h, sz)
		local t = Instance.new("TextLabel"); t.Size = UDim2.new(1, 0, 0, h or 16); t.BackgroundTransparency = 1
		t.Text = text; t.TextColor3 = color or Color3.fromRGB(205, 207, 214); t.TextWrapped = true
		t.TextXAlignment = Enum.TextXAlignment.Left; t.Font = Enum.Font.Gotham; t.TextSize = sz or 13; t.Parent = cr
		return t
	end
	clbl("MESH CUTTER", Color3.fromRGB(70, 160, 255), 22, 16)
	clbl("Split a generated mesh into openable parts — caps the cut so it isn't see-through.", Color3.fromRGB(160, 162, 170), 34)
	clbl("1  ·  Select a MeshPart in the viewport", Color3.fromRGB(205, 207, 214), 18)
	clbl("2  ·  Add Cutter, then drag / rotate the blue plane to where the cut goes", Color3.fromRGB(205, 207, 214), 34)
	clbl("3  ·  Cut  ·  (optional) Make Openable", Color3.fromRGB(205, 207, 214), 18)
	local cstatus = clbl("ready", Color3.fromRGB(150, 200, 140), 32)
	local function cbtn(text, color)
		local b = Instance.new("TextButton"); b.Size = UDim2.new(1, 0, 0, 34); b.BackgroundColor3 = color
		b.TextColor3 = Color3.fromRGB(255, 255, 255); b.Font = Enum.Font.GothamBold; b.TextSize = 14; b.Text = text
		b.AutoButtonColor = true; b.Parent = cr
		local cc = Instance.new("UICorner"); cc.CornerRadius = UDim.new(0, 6); cc.Parent = b
		return b
	end
	local function run(fn)
		local ok, msg = pcall(fn)
		cstatus.Text = ok and tostring(msg) or ("error: " .. tostring(msg))
		cstatus.TextColor3 = ok and Color3.fromRGB(150, 200, 140) or Color3.fromRGB(230, 130, 120)
	end
	cbtn("Add Cutter to Selected", Color3.fromRGB(60, 110, 180)).MouseButton1Click:Connect(function()
		local sel = Selection:Get()[1]
		if sel and sel:IsA("MeshPart") then spawnCutter(sel); cstatus.Text = "Cutter added — move/rotate it, then Cut."; cstatus.TextColor3 = Color3.fromRGB(150, 200, 140)
		else cstatus.Text = "Select a MeshPart first."; cstatus.TextColor3 = Color3.fromRGB(230, 130, 120) end
	end)
	cbtn("Cut", Color3.fromRGB(70, 150, 235)).MouseButton1Click:Connect(function() run(doCut) end)
	cbtn("Make Openable", Color3.fromRGB(60, 64, 72)).MouseButton1Click:Connect(function() run(makeOpenable) end)
	cbtn("Cancel / Remove Cutter", Color3.fromRGB(60, 64, 72)).MouseButton1Click:Connect(function() clearCutter(); cutTarget = nil; cstatus.Text = "cutter removed" end)
	cutBtn.Click:Connect(function() cutWidget.Enabled = not cutWidget.Enabled end)
end
end -- mesh cutter scope

-- Parametric furniture: watch existing tagged pieces + any added/duplicated later, so
-- editing their attributes (Width/Height/Depth/Color...) rebuilds them in place.
scanBuildKit()
workspace.DescendantAdded:Connect(function(d)
	if d:IsA("Model") then
		task.defer(function()
			if d.Parent and d:GetAttribute("BuildKitKind") then
				watchBuildKit(d)
			end
		end)
	end
end)
