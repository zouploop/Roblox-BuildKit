# Everything is ignored by default; only the files explicitly un-ignored below are tracked.
# This whitelist is deliberate: any new root file (a stray key, .env, untracked notes) is
# silently ignored rather than accidentally committed.
/*
!/.gitignore
!/.gitattributes
!/.github/
!/.github/**
!/LICENSE
!/CONTRIBUTING.md

!/vitest.config.ts
!/selene.toml

!/plugin/
/plugin/*
!/plugin/BuildKitPlugin.rbxmx
!/plugin/src/
!/plugin/src/**

!/src/
!/src/**

!/scripts/
!/scripts/**
!/generators/
!/generators/**
!/viewer/
!/viewer/**
/viewer/scene.json
/viewer/.assetcache/
!/library/
/library/*
!/library/.gitkeep

!/skills/
!/skills/**

!/specs/
/specs/*
!/specs/.gitkeep

!/package.json
!/package-lock.json
!/tsconfig.json
!/start.bat

# Build output + local creds (the Open Cloud key lives in ~/.buildkit/config.json, outside
# the repo, so the whitelist above can never track it).
dist/

# Local test suite. Already covered by the root whitelist; kept explicit so adding a new
# root exception cannot accidentally expose test fixtures.
/tests/
