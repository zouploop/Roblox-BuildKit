# Everything is ignored by default; only the files explicitly un-ignored below are tracked.
# This whitelist is deliberate: any new root file (a stray key, .env, untracked notes) is
# silently ignored rather than accidentally committed.
/*
!/.gitignore
!/.gitattributes
!/.github/
!/.github/**
!/LICENSE
!/CONTRIBUTING.md

!/tests/
!/tests/**
!/vitest.config.ts
!/selene.toml

!/plugin/
/plugin/*
!/plugin/BuildKitPlugin.rbxmx
!/plugin/BuildKitPlugin.luau
!/plugin/src/
!/plugin/src/**

!/src/
!/src/**

!/scripts/
!/scripts/**

!/skills/
!/skills/**

!/images/
!/images/**

!/package.json
!/package-lock.json
!/tsconfig.json

# Build output + local creds (the Open Cloud key lives in ~/.buildkit/config.json, outside
# the repo, so the whitelist above can never track it).
dist/
